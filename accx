def renewal_for_month(year: int, month: int, anchor_day: int):
    return datetime(year, month, min(anchor_day, calendar.monthrange(year, month)[1])).date()


def advance_monthly_renewal(value: str, anchor_day: int, today=None) -> str:
    try:
        current = datetime.strptime(value, "%Y-%m-%d").date()
    except ValueError as exc:
        raise ValueError("renewal_date must use YYYY-MM-DD") from exc
    today = today or local_today()
    while current < today:
        year = current.year + (1 if current.month == 12 else 0)
        month = 1 if current.month == 12 else current.month + 1
        current = renewal_for_month(year, month, anchor_day)
    return current.isoformat()


def normalize_billing_input(data: dict[str, Any], today=None) -> dict[str, Any]:
    renewal_date = str(data.get("renewal_date") or "").strip()
    if not renewal_date:
        raise ValueError("renewal_date is required")
    try:
        parsed_date = datetime.strptime(renewal_date, "%Y-%m-%d").date()
    except ValueError as exc:
        raise ValueError("renewal_date must use YYYY-MM-DD") from exc
    try:
        anchor_day = int(data.get("anchor_day") or parsed_date.day)
    except (TypeError, ValueError) as exc:
        raise ValueError("anchor_day must be a day of month") from exc
    if not 1 <= anchor_day <= 31:
        raise ValueError("anchor_day must be between 1 and 31")

    amount_value = data.get("amount")
    amount = None
    currency = str(data.get("currency") or "").strip().upper()
    if amount_value not in (None, ""):
        try:
            decimal_amount = Decimal(str(amount_value))
        except InvalidOperation as exc:
            raise ValueError("amount must be a number") from exc
        if not decimal_amount.is_finite() or decimal_amount < 0:
            raise ValueError("amount must be zero or greater")
        if decimal_amount.as_tuple().exponent < -2:
            raise ValueError("amount supports at most two decimal places")
        if len(currency) != 3 or not currency.isalpha():
            raise ValueError("currency must be a three-letter code")
        amount = f"{decimal_amount:.2f}"
    elif currency and (len(currency) != 3 or not currency.isalpha()):
        raise ValueError("currency must be a three-letter code")

    note_value = data.get("note")
    if note_value not in (None, "") and not isinstance(note_value, str):
        raise ValueError("note must be text")
    note = str(note_value or "").strip()
    if len(note) > 500:
        raise ValueError("note must be 500 characters or fewer")

    return {
        "renewal_date": advance_monthly_renewal(renewal_date, anchor_day, today=today),
        "amount": amount,
        "currency": currency if amount is not None else None,
        "interval": "monthly",
        "anchor_day": anchor_day,
        "note": note or None,
    }


def load_billing(provider: Provider, profile: str) -> dict[str, Any] | None:
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    if not isinstance(settings, dict) or not isinstance(settings.get("billing"), dict):
        return None
    original = settings["billing"]
    try:
        billing = normalize_billing_input(original)
    except ValueError:
        return None
    if billing != original:
        settings["schema"] = WEB_SCHEMA_VERSION
        settings["billing"] = billing
        write_json(path, settings)
    return billing


def save_billing(provider: Provider, profile: str, data: dict[str, Any]) -> dict[str, Any]:
    if profile not in list_profiles(provider):
        raise ValueError(f"profile '{profile}' not found")
    billing = normalize_billing_input(data)
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    if not isinstance(settings, dict):
        settings = {}
    settings["schema"] = WEB_SCHEMA_VERSION
    settings["billing"] = billing
    write_json(path, settings)
    return billing


def normalize_wake_input(data: dict[str, Any]) -> dict[str, Any]:
    enabled = data.get("enabled", True)
    if not isinstance(enabled, bool):
        raise ValueError("enabled must be a boolean")
    recurrence = str(data.get("recurrence") or "").strip()
    if recurrence not in {"once", "daily"}:
        raise ValueError("recurrence must be once or daily")
    time_value = str(data.get("time") or "").strip()
    try:
        datetime.strptime(time_value, "%H:%M")
    except ValueError as exc:
        raise ValueError("time must use HH:MM") from exc
    date_value = str(data.get("date") or "").strip() or None
    if recurrence == "once":
        try:
            datetime.strptime(date_value or "", "%Y-%m-%d")
        except ValueError as exc:
            raise ValueError("date must use YYYY-MM-DD for a one-time wake") from exc
    prompt = data.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        raise ValueError("prompt is required")
    prompt = prompt.strip()
    if len(prompt) > 4000:
        raise ValueError("prompt must be 4000 characters or fewer")
    return {
        "enabled": enabled,
        "recurrence": recurrence,
        "date": date_value if recurrence == "once" else None,
        "time": time_value,
        "prompt": prompt,
        "last_run_at": data.get("last_run_at") if isinstance(data.get("last_run_at"), str) else None,
        "last_result": data.get("last_result") if isinstance(data.get("last_result"), str) else None,
    }


def wake_candidate(wake: dict[str, Any], now: datetime | None = None) -> datetime | None:
    if not wake.get("enabled"):
        return None
    now = now or datetime.now().astimezone()
    hour, minute = (int(part) for part in wake["time"].split(":"))
    if wake["recurrence"] == "once":
        target_date = datetime.strptime(wake["date"], "%Y-%m-%d").date()
        candidate = datetime.combine(target_date, datetime.min.time(), tzinfo=now.tzinfo).replace(hour=hour, minute=minute)
        return candidate
    candidate = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    last_run = parse_iso_datetime(wake.get("last_run_at"))
    if last_run:
        last_run = last_run.astimezone(now.tzinfo)
    if candidate <= now and last_run and last_run >= candidate:
        candidate += timedelta(days=1)
    return candidate


def wake_public_data(wake: dict[str, Any] | None, now: datetime | None = None) -> dict[str, Any] | None:
    if not wake:
        return None
    candidate = wake_candidate(wake, now=now)
    result = dict(wake)
    result["next_run_at"] = candidate.isoformat() if candidate else None
    result["expected_reset_at"] = (candidate + timedelta(hours=5)).isoformat() if candidate else None
    return result


def load_wake(provider: Provider, profile: str) -> dict[str, Any] | None:
    settings = read_json(provider.stored_settings_path(profile), {}, strict=False)
    if not isinstance(settings, dict) or not isinstance(settings.get("wake"), dict):
        return None
    try:
        return normalize_wake_input(settings["wake"])
    except ValueError as exc:
        wake_log("schedule_invalid", provider=provider.name, profile=profile, error=str(exc))
        return None


def save_wake(provider: Provider, profile: str, data: dict[str, Any]) -> dict[str, Any]:
    if profile not in list_profiles(provider):
        raise ValueError(f"profile '{profile}' not found")
    wake = normalize_wake_input(data)
    current = load_wake(provider, profile)
    schedule_changed = not current or any(current.get(key) != wake.get(key) for key in ("recurrence", "date", "time"))
    if current and not schedule_changed:
        wake["last_run_at"] = current.get("last_run_at")
        wake["last_result"] = current.get("last_result")
    elif wake["recurrence"] == "daily":
        now = datetime.now().astimezone()
        candidate = wake_candidate(wake, now=now)
        if candidate and candidate <= now:
            wake["last_run_at"] = now.isoformat()
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    if not isinstance(settings, dict):
        settings = {}
    settings["schema"] = WEB_SCHEMA_VERSION
    settings["wake"] = wake
    write_json(path, settings)
    wake_log(
        "schedule_saved",
        provider=provider.name,
        profile=profile,
        enabled=wake["enabled"],
        recurrence=wake["recurrence"],
        date=wake["date"],
        time=wake["time"],
    )
    return wake


def wake_command(provider: Provider, prompt: str) -> list[str]:
    if provider.name == "claude":
        return ["claude", "-p", prompt, "--model", "haiku"]
    return [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "--model",
        "gpt-5.1-codex-mini",
        prompt,
    ]


def start_wake(provider: Provider, profile: str, wake: dict[str, Any]) -> str:
    if shutil.which(provider.cli) is None:
        result = f"failed: {provider.cli} command not found"
        wake_log("wake_failed", provider=provider.name, profile=profile, error=result)
        return result
    runtime_dir = provider.profile_dir(profile) / ".wake-runtime"
    runtime_dir.mkdir(parents=True, exist_ok=True)
    output_path = runtime_dir / "wake.log"
    credential_name = ".credentials.json" if provider.name == "claude" else "auth.json"
    copy_file(provider.stored_credential_path(profile), runtime_dir / credential_name)
    env = os.environ.copy()
    if provider.name == "claude":
        env["CLAUDE_CONFIG_DIR"] = str(runtime_dir)
    else:
        source_config = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser() / "config.toml"
        if source_config.exists():
            copy_file(source_config, runtime_dir / "config.toml")
        env["CODEX_HOME"] = str(runtime_dir)
    try:
        with output_path.open("ab") as output:
            process = subprocess.Popen(
                wake_command(provider, wake["prompt"]),
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
    except OSError as exc:
        result = f"failed: {exc}"
        wake_log("wake_failed", provider=provider.name, profile=profile, error=result)
        return result
    wake_log(
        "wake_started",
        provider=provider.name,
        profile=profile,
        pid=process.pid,
        output=str(output_path),
    )

    def record_completion() -> None:
        exit_code = process.wait()
        wake_log(
            "wake_completed",
            provider=provider.name,
            profile=profile,
            pid=process.pid,
            exit_code=exit_code,
            output=str(output_path),
        )

    if isinstance(process.pid, int):
        threading.Thread(target=record_completion, name=f"accx-wake-{process.pid}", daemon=True).start()
    return "started"


def process_due_wakes(now: datetime | None = None) -> list[dict[str, Any]]:
    now = now or datetime.now().astimezone()
    results = []
    for provider_name in ("claude", "codex"):
        provider = Provider(provider_name)
        for profile in list_profiles(provider):
            try:
                wake = load_wake(provider, profile)
                if not wake:
                    continue
                candidate = wake_candidate(wake, now=now)
                if not candidate or candidate > now:
                    continue
                wake_log(
                    "wake_due",
                    provider=provider_name,
                    profile=profile,
                    scheduled_at=candidate.isoformat(),
                )
                result = start_wake(provider, profile, wake)
                wake["last_result"] = result
                if result == "started":
                    wake["last_run_at"] = now.isoformat()
                    if wake["recurrence"] == "once":
                        wake["enabled"] = False
                path = provider.stored_settings_path(profile)
                settings = read_json(path, {}, strict=False)
                settings = settings if isinstance(settings, dict) else {}
                settings["schema"] = WEB_SCHEMA_VERSION
                settings["wake"] = wake
                write_json(path, settings)
                results.append({"provider": provider_name, "profile": profile, "result": result})
            except Exception as exc:
                wake_log(
                    "wake_check_failed",
                    provider=provider_name,
                    profile=profile,
                    error=str(exc),
                    traceback=traceback.format_exc(),
                )
    return results


def read_text_tail(path: Path, max_bytes: int = 65536) -> str:
    try:
        with path.open("rb") as source:
            source.seek(0, os.SEEK_END)
            size = source.tell()
            source.seek(max(0, size - max_bytes))
            data = source.read()
    except OSError:
        return ""
    text = data.decode("utf-8", errors="replace")
    if size > max_bytes and "\n" in text:
        text = text.split("\n", 1)[1]
    return text.rstrip()


def wake_monitor_data(event_limit: int = 200) -> dict[str, Any]:
    plans = []
    for provider_name in ("claude", "codex"):
        provider = Provider(provider_name)
        for profile in list_profiles(provider):
            wake = load_wake(provider, profile)
            if not wake:
                continue
            public = wake_public_data(wake) or {}
            plans.append({
                "provider": provider_name,
                "profile": profile,
                "model": "haiku" if provider_name == "claude" else "gpt-5.1-codex-mini",
                "output": read_text_tail(provider.profile_dir(profile) / ".wake-runtime" / "wake.log"),
                **public,
            })

    events = []
    for line in read_text_tail(accx_home() / "wake.log", max_bytes=256 * 1024).splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict):
            events.append(event)
    return {
        "generated_at": now_iso(),
        "plans": plans,
        "events": list(reversed(events[-event_limit:])),
    }


def usage_cache_values(
    provider: Provider,
    profile: str,
    use_api: bool,
    cred: dict[str, Any],
    active: bool = False,
) -> tuple[str, str, str, str]:
    cache_path = provider.stored_cache_path(profile)
    raw = None
    if use_api:
        if provider.name == "codex":
            refreshed = codex_token_needs_refresh(cred) and refresh_codex_credential(cred)
            if refreshed and active:
                write_json(provider.live_credential_path(), cred)
            if refreshed or active:
                write_json(provider.stored_credential_path(profile), cred)
                write_json(provider.stored_meta_path(profile), credential_summary(provider, cred))
        raw = fetch_usage(provider, cred)
        if raw:
            fetched_at = now_iso()
            write_json(cache_path, {"fetched_at": fetched_at, "raw": raw})
    else:
        cache = read_json(cache_path, {}, strict=False)
        if isinstance(cache, dict):
            raw = cache.get("raw")
    if not isinstance(raw, dict):
        return "?", "?", "?", "?"
    if provider.name == "claude":
        five = raw.get("five_hour") or {}
        seven = raw.get("seven_day") or {}
        return (
            str(five.get("utilization", "?")),
            str(seven.get("utilization", "?")),
            str(five.get("resets_at", "?"))[:16],
            str(seven.get("resets_at", "?"))[:16],
        )
    rate = raw.get("rate_limit") or {}
    primary = rate.get("primary_window") or {}
    secondary = rate.get("secondary_window") or {}
    return (
        str(primary.get("used_percent", "?")),
        str(secondary.get("used_percent", "?")),
        str(primary.get("reset_at", "?")),
        str(secondary.get("reset_at", "?")),
    )


def list_command(provider: Provider, use_api: bool) -> None:
    profiles = list_profiles(provider)
    if not profiles:
        print()
        print(f"  No saved {provider.name} profiles.")
        print(f"  Use 'accx {provider.name} save <name>' to save the current account.")
        print()
        return

    active = detect_active_profile(provider)
    print()
    print(f"  {C.bold}{'PROFILE':14} {'EMAIL':28} {'PLAN':10} {'EXP':20} {'5H%':>6} {'7D%':>6}{C.off}")
    for profile in profiles:
        cred_path = provider.stored_credential_path(profile)
        if not cred_path.exists():
            continue
        if profile == active and provider.live_credential_path().exists():
            cred_path = provider.live_credential_path()
        cred = read_credential(provider, cred_path)
        p5, p7, _, _ = usage_cache_values(provider, profile, use_api, cred, active=profile == active)
        meta = credential_summary(provider, cred) if provider.name == "codex" else load_profile_meta(provider, profile)
        ident = meta.get("identity") or {}
        cmeta = meta.get("credential") or {}
        marker = "*" if profile == active else " "
        email = (ident.get("email") or "?")[:28]
        plan = (ident.get("plan") or "?")[:10]
        exp = (cmeta.get("access_expires_at") or "?")[:20]
        print(f"  {marker}{profile[:13]:13} {C.dim}{email:28}{C.off} {plan:10} {exp:20} {p5:>5}% {p7:>5}%")
    print()
    if active:
        print("  * = active profile")
    print("  Refreshed via API" if use_api else "  Using cache; add --api to refresh")
    print()


def profile_credential(provider: Provider, profile: str, active: str | None = None) -> dict[str, Any]:
    active = active if active is not None else detect_active_profile(provider)
    path = provider.live_credential_path() if profile == active and provider.live_credential_path().exists() else provider.stored_credential_path(profile)
    return read_credential(provider, path)


def profile_dashboard_data(provider: Provider, profile: str, active: str | None = None) -> dict[str, Any]:
    active = active if active is not None else detect_active_profile(provider)
    cred = profile_credential(provider, profile, active)
    meta = credential_summary(provider, cred) if provider.name == "codex" else load_profile_meta(provider, profile)
    ident = meta.get("identity") or {}
    credential = meta.get("credential") or {}
    raw, fetched_at = load_usage_cache(provider, profile)
    usage = usage_snapshot(provider, raw, recorded_at=fetched_at) if raw else None
    return {
        "provider": provider.name,
        "profile": profile,
        "active": profile == active,
        "email": ident.get("email"),
        "display_name": ident.get("display_name"),
        "plan": ident.get("plan"),
        "access_expires_at": credential.get("access_expires_at"),
        "usage": usage,
        "billing": load_billing(provider, profile),
        "wake": wake_public_data(load_wake(provider, profile)),
    }


def dashboard_data() -> dict[str, Any]:
    profiles = []
    totals: dict[str, Decimal] = {}
    for provider_name in ("claude", "codex"):
        provider = Provider(provider_name)
        active = detect_active_profile(provider)
        for profile in list_profiles(provider):
            if not provider.stored_credential_path(profile).exists():
                continue
            try:
                item = profile_dashboard_data(provider, profile, active)
            except SystemExit:
                item = {
                    "provider": provider.name,
                    "profile": profile,
                    "active": profile == active,
                    "email": None,
                    "display_name": None,
                    "plan": None,
                    "access_expires_at": None,
                    "usage": None,
                    "billing": load_billing(provider, profile),
                    "wake": wake_public_data(load_wake(provider, profile)),
                    "error": "profile data could not be read",
                }
            profiles.append(item)
            billing = item.get("billing") or {}
            if billing.get("amount") is not None and billing.get("currency"):
                currency = billing["currency"]
                totals[currency] = totals.get(currency, Decimal("0")) + Decimal(billing["amount"])
    return {
        "generated_at": now_iso(),
        "auto_refresh_seconds": AUTO_REFRESH_SECONDS,
        "profiles": profiles,
        "monthly_totals": {currency: f"{amount:.2f}" for currency, amount in sorted(totals.items())},
    }


def cache_is_fresh(provider: Provider, profile: str, max_age: int = AUTO_REFRESH_SECONDS) -> bool:
    _, fetched_at = load_usage_cache(provider, profile)
    fetched = parse_iso_datetime(fetched_at)
    return bool(fetched and (datetime.now(timezone.utc) - fetched).total_seconds() < max_age)


def refresh_profile_usage(provider: Provider, profile: str, force: bool = False) -> dict[str, Any]:
    if profile not in list_profiles(provider):
        raise ValueError(f"profile '{profile}' not found")
    active = detect_active_profile(provider)
    if not force and cache_is_fresh(provider, profile):
        return {"profile": profile, "provider": provider.name, "status": "cached"}
    cred = profile_credential(provider, profile, active)
    before_raw, _ = load_usage_cache(provider, profile)
    cache_path = provider.stored_cache_path(profile)
    before_mtime = cache_path.stat().st_mtime_ns if cache_path.exists() else None
    usage_cache_values(provider, profile, True, cred, active=profile == active)
    raw, fetched_at = load_usage_cache(provider, profile)
    after_mtime = cache_path.stat().st_mtime_ns if cache_path.exists() else None
    if raw is None or after_mtime == before_mtime:
        return {
            "profile": profile,
            "provider": provider.name,
            "status": "unavailable",
            "has_cached_data": before_raw is not None,
        }
    return {"profile": profile, "provider": provider.name, "status": "refreshed", "fetched_at": fetched_at}


def refresh_dashboard_usage(provider_name: str | None = None, profile: str | None = None, force: bool = False) -> list[dict[str, Any]]:
    if provider_name is not None and provider_name not in {"claude", "codex"}:
        raise ValueError("provider must be claude or codex")
    if profile is not None and not provider_name:
        raise ValueError("provider is required when profile is specified")
    if profile is not None and profile not in list_profiles(Provider(provider_name)):
        raise ValueError(f"profile '{profile}' not found")
    results = []
    names = (provider_name,) if provider_name else ("claude", "codex")
    for name in names:
        provider = Provider(name)
        targets = (profile,) if profile else tuple(list_profiles(provider))
        for target in targets:
            if target and provider.stored_credential_path(target).exists():
                results.append(refresh_profile_usage(provider, target, force=force))
    return results


