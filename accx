def reset_value_to_iso(value: Any) -> str | None:
    if value in (None, "", "?"):
        return None
    if isinstance(value, (int, float)):
        return epoch_to_iso(value)
    parsed = parse_iso_datetime(str(value))
    return parsed.astimezone(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z") if parsed else str(value)


