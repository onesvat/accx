class DashboardState:
    def __init__(self) -> None:
        self.token = secrets.token_urlsafe(32)
        self.lock = threading.Lock()


class DashboardHandler(BaseHTTPRequestHandler):
    server_version = "accx-dashboard"
    state: DashboardState
    asset_root: Path
    bind_host: str

    def log_message(self, fmt: str, *args: Any) -> None:
        print(f"  {self.address_string()} - {fmt % args}")

    def send_bytes(self, status: int, body: bytes, content_type: str, cache: bool = False) -> None:
        try:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "public, max-age=300" if cache else "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header(
                "Content-Security-Policy",
                "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'",
            )
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def send_json(self, status: int, data: Any) -> None:
        self.send_bytes(status, json.dumps(data, separators=(",", ":")).encode("utf-8"), "application/json; charset=utf-8")

    def read_json_body(self) -> dict[str, Any]:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError as exc:
            raise ValueError("invalid content length") from exc
        if length > 65536:
            raise ValueError("request body is too large")
        try:
            data = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError as exc:
            raise ValueError("request body must be valid JSON") from exc
        if not isinstance(data, dict):
            raise ValueError("request body must be a JSON object")
        return data

    def mutation_allowed(self) -> bool:
        host = self.headers.get("Host", "").split(":", 1)[0]
        allowed_hosts = {self.bind_host, "127.0.0.1", "localhost"}
        return (
            host in allowed_hosts
            and self.headers.get("X-ACCX-Token") == self.state.token
            and self.headers.get("Content-Type", "").split(";", 1)[0] == "application/json"
        )

    def serve_asset(self, requested: str) -> None:
        filename = "index.html" if requested == "/" else requested.removeprefix("/")
        if filename not in {"index.html", "app.js", "wake.html", "wake.js", "styles.css"}:
            self.send_json(404, {"error": "not found"})
            return
        path = self.asset_root / filename
        if not path.exists():
            self.send_json(500, {"error": "dashboard asset missing"})
            return
        body = path.read_bytes()
        if filename == "index.html":
            body = body.replace(b"__ACCX_TOKEN__", self.state.token.encode("ascii"))
        content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
        self.send_bytes(200, body, f"{content_type}; charset=utf-8", cache=filename != "index.html")

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if not parsed.path.startswith("/api/"):
            self.serve_asset(parsed.path)
            return
        try:
            if parsed.path == "/api/dashboard":
                with self.state.lock:
                    data = dashboard_data()
                self.send_json(200, data)
                return
            if parsed.path == "/api/wakes":
                with self.state.lock:
                    data = wake_monitor_data()
                self.send_json(200, data)
                return
            self.send_json(404, {"error": "not found"})
        except (ValueError, TypeError) as exc:
            self.send_json(400, {"error": str(exc)})
        except SystemExit:
            self.send_json(500, {"error": "dashboard data could not be read"})
        except Exception:
            self.send_json(500, {"error": "dashboard request failed"})

    def do_POST(self) -> None:
        self.handle_mutation("POST")

    def do_PUT(self) -> None:
        self.handle_mutation("PUT")

    def handle_mutation(self, method: str) -> None:
        if not self.mutation_allowed():
            self.send_json(403, {"error": "forbidden"})
            return
        parsed = urllib.parse.urlparse(self.path)
        try:
            data = self.read_json_body()
            with self.state.lock:
                if method == "POST" and parsed.path == "/api/usage/refresh":
                    force = data.get("force", False)
                    if not isinstance(force, bool):
                        raise ValueError("force must be a boolean")
                    results = refresh_dashboard_usage(data.get("provider"), data.get("profile"), force)
                    self.send_json(200, {"results": results, "dashboard": dashboard_data()})
                    return
                parts = [urllib.parse.unquote(part) for part in parsed.path.strip("/").split("/")]
                if len(parts) == 5 and parts[:2] == ["api", "profiles"]:
                    provider = Provider(parts[2])
                    profile = parts[3]
                    if method == "POST" and parts[4] == "switch":
                        if profile not in list_profiles(provider):
                            raise ValueError(f"profile '{profile}' not found")
                        result = perform_switch_profile(provider, profile)
                        self.send_json(200, {"result": result, "dashboard": dashboard_data()})
                        return
                    if method == "PUT" and parts[4] == "billing":
                        billing = save_billing(provider, profile, data)
                        self.send_json(200, {"billing": billing, "dashboard": dashboard_data()})
                        return
                    if method == "PUT" and parts[4] == "wake":
                        wake = save_wake(provider, profile, data)
                        self.send_json(200, {"wake": wake_public_data(wake), "dashboard": dashboard_data()})
                        return
                self.send_json(404, {"error": "not found"})
        except (ValueError, TypeError) as exc:
            self.send_json(400, {"error": str(exc)})
        except SystemExit:
            self.send_json(500, {"error": "profile operation failed"})
        except Exception:
            self.send_json(500, {"error": "dashboard request failed"})


def run_web_dashboard(port: int, bind: str = "127.0.0.1", open_browser: bool = True) -> None:
    if not 1 <= port <= 65535:
        die("web port must be between 1 and 65535")
    asset_root = Path(__file__).resolve().parent / "web"
    if not (asset_root / "index.html").exists():
        die(f"dashboard assets not found: {asset_root}")
    state = DashboardState()

    class Handler(DashboardHandler):
        pass

    Handler.state = state
    Handler.asset_root = asset_root
    Handler.bind_host = bind
    try:
        server = ThreadingHTTPServer((bind, port), Handler)
    except OSError as exc:
        die(f"could not start dashboard on {bind}:{port}: {exc}")
    url = f"http://{bind}:{server.server_port}/"
    print(f"ACCX dashboard: {url}")
    print("Press Ctrl+C to stop.")
    if open_browser:
        threading.Timer(0.2, lambda: webbrowser.open(url)).start()
    scheduler_stop = threading.Event()
    wake_log("scheduler_started", check_interval_seconds=WAKE_CHECK_SECONDS)

    def run_scheduler() -> None:
        while not scheduler_stop.is_set():
            try:
                with state.lock:
                    results = process_due_wakes()
                for result in results:
                    print(f"Auto wake {result['provider']}/{result['profile']}: {result['result']}")
            except Exception as exc:
                wake_log("scheduler_check_failed", error=str(exc), traceback=traceback.format_exc())
                print(f"Auto wake check failed: {exc}", file=sys.stderr)
            scheduler_stop.wait(WAKE_CHECK_SECONDS)

    scheduler = threading.Thread(target=run_scheduler, name="accx-wake-scheduler", daemon=True)
    scheduler.start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nDashboard stopped.")
    finally:
        scheduler_stop.set()
        scheduler.join(timeout=2)
        wake_log("scheduler_stopped")
        server.server_close()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="accx",
        description="Switch between Claude Code and Codex CLI accounts.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"accx {VERSION}")

    sub = parser.add_subparsers(dest="provider", required=True)
    web_p = sub.add_parser("web", help="open the local account dashboard")
    web_p.add_argument("--port", type=int, default=8765, help="local port (default: 8765)")
    web_p.add_argument("--bind", default="127.0.0.1", help="bind address (default: 127.0.0.1)")
    web_p.add_argument("--no-open", action="store_true", help="do not open a browser")

    for provider_name in ("claude", "codex"):
        p = sub.add_parser(provider_name)
        commands = p.add_subparsers(dest="command", required=True)

        list_p = commands.add_parser("list", help="list saved profiles")
        list_p.add_argument("--api", action="store_true", help="fetch live usage")

        save_p = commands.add_parser("save", help="save current account")
        save_p.add_argument("name")

        add_p = commands.add_parser("add", help="add another account without logout")
        add_p.add_argument("name")
        add_p.add_argument("login_args", nargs=argparse.REMAINDER)

        switch_p = commands.add_parser("switch", help="switch to a saved account")
        switch_p.add_argument("name")

        identity_p = commands.add_parser("identity", help="show active account")
        identity_p.add_argument("--api", action="store_true", help="fetch live usage")

        remove_p = commands.add_parser("remove", help="remove stored profile")
        remove_p.add_argument("name")

        commands.add_parser("paths", help="show auth paths and env overrides")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.provider == "web":
        run_web_dashboard(args.port, bind=args.bind, open_browser=not args.no_open)
        return 0
    provider = Provider(args.provider)

    if args.command == "list":
        list_command(provider, args.api)
    elif args.command == "save":
        save_profile(provider, args.name)
    elif args.command == "add":
        add_profile(provider, args.name, args.login_args)
    elif args.command == "switch":
        switch_profile(provider, args.name)
    elif args.command == "identity":
        print_identity(provider, args.api)
    elif args.command == "remove":
        remove_profile(provider, args.name)
    elif args.command == "paths":
        paths_command(provider)
    else:
        die(f"unknown command: {args.command}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
