def dashboard_data() -> dict[str, Any]:
    profiles = []
    totals: dict[str, Decimal] = {}
    for provider_name in ("claude", "codex", "opencode"):
        provider = Provider(provider_name)
        active = detect_active_profile(provider)
        for profile in list_profiles(provider):
            if not provider.stored_credential_path(profile).exists():
                continue
            try:
                item = profile_dashboard_data(provider, profile, active)
            except SystemExit:
                item = {
                    "provider": provider.name,
                    "profile": profile,
                    "active": profile == active,
                    "email": None,
                    "display_name": None,
                    "plan": None,
                    "access_expires_at": None,
                    "usage": None,
                    "billing": load_billing(provider, profile),
                    "wake": wake_public_data(load_wake(provider, profile)),
                    "error": "profile data could not be read",
                }
            profiles.append(item)
            billing = item.get("billing") or {}
            if billing.get("amount") is not None and billing.get("currency"):
                currency = billing["currency"]
                totals[currency] = totals.get(currency, Decimal("0")) + Decimal(billing["amount"])
    return {
        "generated_at": now_iso(),
        "auto_refresh_seconds": AUTO_REFRESH_SECONDS,
        "profiles": profiles,
        "monthly_totals": {currency: f"{amount:.2f}" for currency, amount in sorted(totals.items())},
    }


def refresh_opencode_identity(provider: Provider, profile: str, cred: dict[str, Any]) -> None:
    response = http_get_json("https://opencode.ai/console/api/members", {
        "Authorization": f"Bearer {cred['key']}", "User-Agent": "accx/" + VERSION,
    })
    if not isinstance(response, dict):
        return
    items = response.get("items") or []
    total = (response.get("pageInfo") or {}).get("total")
    # A workspace member list identifies the account only in a single-member workspace.
    # Never assign the first member's email in a shared workspace.
    if total != 1 or len(items) != 1 or not isinstance(items[0], dict):
        return
    member = items[0]
    if not member.get("email") or member.get("disabledAt"):
        return
    meta = credential_summary(provider, cred)
    meta["identity"].update({"email": member["email"], "display_name": member.get("displayName"),
                             "account_id": member.get("userId"), "email_source": "single_workspace_member"})
    write_json(provider.stored_meta_path(profile), meta)


@store_operation
def refresh_profile_usage(provider: Provider, profile: str, force: bool = False) -> dict[str, Any]:
    if profile not in list_profiles(provider):
        raise ValueError(f"profile '{profile}' not found")
    active = detect_active_profile(provider)
    cache_path = provider.stored_cache_path(profile)
    cache = read_json(cache_path, {}, strict=False)
    cache = cache if isinstance(cache, dict) else {}
    attempt = parse_iso_datetime(cache.get("last_attempt_at") or cache.get("fetched_at"))
    if not force and attempt and (datetime.now(timezone.utc) - attempt).total_seconds() < AUTO_REFRESH_SECONDS:
        return {"profile": profile, "provider": provider.name,
                "status": "unavailable" if cache.get("refresh_status") == "unavailable" else "cached",
                "has_cached_data": isinstance(cache.get("raw"), dict)}
    cred = profile_credential(provider, profile, active)
    usage_cache_values(provider, profile, True, cred, active=profile == active)
    cache = read_json(cache_path, {}, strict=False)
    if cache.get("refresh_status") != "refreshed":
        return {"profile": profile, "provider": provider.name, "status": "unavailable",
                "has_cached_data": isinstance(cache.get("raw"), dict)}
    if provider.name == "opencode":
        refresh_opencode_identity(provider, profile, cred)
    return {"profile": profile, "provider": provider.name, "status": "refreshed", "fetched_at": cache["fetched_at"]}


def refresh_dashboard_usage(provider_name: str | None = None, profile: str | None = None, force: bool = False) -> list[dict[str, Any]]:
    if provider_name is not None and provider_name not in {"claude", "codex", "opencode"}:
        raise ValueError("provider must be claude or codex")
    if profile is not None and not provider_name:
        raise ValueError("provider is required when profile is specified")
    if profile is not None and profile not in list_profiles(Provider(provider_name)):
        raise ValueError(f"profile '{profile}' not found")
    results = []
    names = (provider_name,) if provider_name else ("claude", "codex", "opencode")
    for name in names:
        provider = Provider(name)
        targets = (profile,) if profile else tuple(list_profiles(provider))
        for target in targets:
            if target and provider.stored_credential_path(target).exists():
                results.append(refresh_profile_usage(provider, target, force=force))
    return results


