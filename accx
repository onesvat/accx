class DashboardState:
    def __init__(self) -> None:
        self.token = secrets.token_urlsafe(32)
        self.lock = threading.Lock()


class DashboardHandler(BaseHTTPRequestHandler):
    server_version = "accx-dashboard"
    state: DashboardState
    asset_root: Path
    bind_host: str

    def log_message(self, fmt: str, *args: Any) -> None:
        print(f"  {self.address_string()} - {fmt % args}")

    def send_bytes(self, status: int, body: bytes, content_type: str, cache: bool = False) -> None:
        try:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "public, max-age=300" if cache else "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header(
                "Content-Security-Policy",
                "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'",
            )
            self.end_headers()
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True

    def send_json(self, status: int, data: Any) -> None:
        self.send_bytes(status, json.dumps(data, separators=(",", ":")).encode("utf-8"), "application/json; charset=utf-8")

    def read_json_body(self) -> dict[str, Any]:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError as exc:
            raise ValueError("invalid content length") from exc
        if length > 65536:
            raise ValueError("request body is too large")
        try:
            data = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError as exc:
            raise ValueError("request body must be valid JSON") from exc
        if not isinstance(data, dict):
            raise ValueError("request body must be a JSON object")
        return data

    def mutation_allowed(self) -> bool:
        host = self.headers.get("Host", "").split(":", 1)[0]
        allowed_hosts = {self.bind_host, "127.0.0.1", "localhost"}
        if self.bind_host in {"0.0.0.0", "::"}:
            # Binding to all interfaces means the dashboard is intentionally reachable
            # through the machine's LAN addresses; the per-process token still protects writes.
            allowed_hosts.add(host)
        return (
            host in allowed_hosts
            and self.headers.get("X-ACCX-Token") == self.state.token
            and self.headers.get("Content-Type", "").split(";", 1)[0] == "application/json"
        )

    def serve_asset(self, requested: str) -> None:
        filename = "index.html" if requested == "/" else requested.removeprefix("/")
        if filename not in {"index.html", "app.js", "wake.html", "wake.js", "styles.css"}:
            self.send_json(404, {"error": "not found"})
            return
        path = self.asset_root / filename
        if not path.exists():
            self.send_json(500, {"error": "dashboard asset missing"})
            return
        body = path.read_bytes()
        if filename == "index.html":
            body = body.replace(b"__ACCX_TOKEN__", self.state.token.encode("ascii"))
        if filename in {"index.html", "wake.html"}:
            for asset in ("app.js", "wake.js", "styles.css"):
                asset_path = self.asset_root / asset
                if asset_path.exists():
                    version = hashlib.sha256(asset_path.read_bytes()).hexdigest()[:12]
                    body = body.replace(f'"/{asset}"'.encode(), f'"/{asset}?v={version}"'.encode())
        content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
        self.send_bytes(200, body, f"{content_type}; charset=utf-8", cache=filename != "index.html")

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if not parsed.path.startswith("/api/"):
            self.serve_asset(parsed.path)
            return
        try:
            if parsed.path == "/api/dashboard":
                with self.state.lock:
                    data = dashboard_data()
                self.send_json(200, data)
                return
            if parsed.path == "/api/wakes":
                with self.state.lock:
                    data = wake_monitor_data()
                self.send_json(200, data)
                return
            self.send_json(404, {"error": "not found"})
        except (ValueError, TypeError) as exc:
            self.send_json(400, {"error": str(exc)})
        except SystemExit:
            self.send_json(500, {"error": "dashboard data could not be read"})
        except Exception:
            self.send_json(500, {"error": "dashboard request failed"})

    def do_POST(self) -> None:
        self.handle_mutation("POST")

    def do_PUT(self) -> None:
        self.handle_mutation("PUT")

    def handle_mutation(self, method: str) -> None:
        if not self.mutation_allowed():
            self.send_json(403, {"error": "forbidden"})
            return
        parsed = urllib.parse.urlparse(self.path)
        try:
            data = self.read_json_body()
            with self.state.lock:
                if method == "POST" and parsed.path == "/api/opencode/profiles":
                    save_opencode_key(data.get("profile", ""), data.get("api_key"))
                    self.send_json(200, {"dashboard": dashboard_data()})
                    return
                if method == "POST" and parsed.path == "/api/usage/refresh":
                    force = data.get("force", False)
                    if not isinstance(force, bool):
                        raise ValueError("force must be a boolean")
                    results = refresh_dashboard_usage(data.get("provider"), data.get("profile"), force)
                    self.send_json(200, {"results": results, "dashboard": dashboard_data()})
                    return
                parts = [urllib.parse.unquote(part) for part in parsed.path.strip("/").split("/")]
                if len(parts) == 5 and parts[:2] == ["api", "profiles"]:
                    provider = Provider(parts[2])
                    profile = parts[3]
                    if method == "POST" and parts[4] == "switch":
                        if profile not in list_profiles(provider):
                            raise ValueError(f"profile '{profile}' not found")
                        kill_sessions = data.get("kill_sessions", False)
                        if not isinstance(kill_sessions, bool):
                            raise ValueError("kill_sessions must be a boolean")
                        result = perform_switch_profile(provider, profile, kill_sessions=kill_sessions)
                        self.send_json(200, {"result": result, "dashboard": dashboard_data()})
                        return
                    if method == "PUT" and parts[4] == "billing":
                        billing = save_billing(provider, profile, data)
                        self.send_json(200, {"billing": billing, "dashboard": dashboard_data()})
                        return
                    if method == "PUT" and parts[4] == "wake":
                        wake = save_wake(provider, profile, data)
                        self.send_json(200, {"wake": wake_public_data(wake), "dashboard": dashboard_data()})
                        return
                self.send_json(404, {"error": "not found"})
        except ActiveSessionsError as exc:
            self.send_json(
                409,
                {
                    "error": str(exc),
                    "active_sessions": exc.sessions,
                    "can_kill": not any(session.get("ancestor") for session in exc.sessions),
                },
            )
        except (ValueError, TypeError) as exc:
            self.send_json(400, {"error": str(exc)})
        except SystemExit:
            self.send_json(500, {"error": "profile operation failed"})
        except Exception:
            self.send_json(500, {"error": "dashboard request failed"})


def run_wake_scheduler(stop: threading.Event) -> None:
    while not stop.is_set():
        try:
            with file_lock(".wake-scheduler.lock", blocking=False) as owner:
                if owner:
                    since = datetime.now().astimezone()
                    process_due_notifications()
                    while not stop.wait(WAKE_CHECK_SECONDS):
                        now = datetime.now().astimezone()
                        # A suspended machine or a long pause is a new scheduling window.
                        if timedelta(0) <= now - since <= timedelta(seconds=3 * WAKE_CHECK_SECONDS):
                            process_due_wakes(now, since)
                        since = now
                        process_due_notifications()
        except (Exception, SystemExit) as exc:
            wake_log("scheduler_check_failed", error=str(exc))
        stop.wait(WAKE_CHECK_SECONDS)


def run_usage_refresh(stop: threading.Event, providers: tuple[str, ...]) -> None:
    while not stop.is_set():
        for name in providers:
            provider = Provider(name)
            for profile in list_profiles(provider):
                if stop.is_set():
                    return
                try:
                    refresh_profile_usage(provider, profile, force=False)
                except (Exception, SystemExit):
                    wake_log("usage_refresh_failed", provider=name, profile=profile)
        stop.wait(AUTO_REFRESH_SECONDS)


def run_web_dashboard(port: int, bind: str = "127.0.0.1", open_browser: bool = True) -> None:
    if not 1 <= port <= 65535:
        die("web port must be between 1 and 65535")
    asset_root = Path(__file__).resolve().parent / "web"
    if not (asset_root / "index.html").exists():
        die(f"dashboard assets not found: {asset_root}")
    state = DashboardState()

    class Handler(DashboardHandler):
        pass

    Handler.state = state
    Handler.asset_root = asset_root
    Handler.bind_host = bind
    try:
        server = ThreadingHTTPServer((bind, port), Handler)
    except OSError as exc:
        die(f"could not start dashboard on {bind}:{port}: {exc}")
    url = f"http://{bind}:{server.server_port}/"
    print(f"ACCX dashboard: {url}")
    print("Press Ctrl+C to stop.")
    if open_browser:
        threading.Timer(0.2, lambda: webbrowser.open(url)).start()
    scheduler_stop = threading.Event()
    wake_log("scheduler_started", check_interval_seconds=WAKE_CHECK_SECONDS)
    scheduler = threading.Thread(target=run_wake_scheduler, args=(scheduler_stop,),
                                 name="accx-wake-scheduler", daemon=True)
    usage_thread = threading.Thread(target=run_usage_refresh, args=(scheduler_stop, (*MACHINE_PROVIDERS, "opencode")),
                                    name="accx-usage-refresh", daemon=True)
    scheduler.start()
    usage_thread.start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nDashboard stopped.")
    finally:
        scheduler_stop.set()
        scheduler.join(timeout=2)
        usage_thread.join(timeout=2)
        wake_log("scheduler_stopped")
        server.server_close()


MACHINE_VERSION = 1
MACHINE_LINE_LIMIT = 64 * 1024
MACHINE_ID = re.compile(r"[A-Za-z0-9_.:-]{1,80}\Z")
MACHINE_LABEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9_. -]{0,39}\Z")
MACHINE_WINDOW = re.compile(r"[\w .·:-]{1,100}\Z")


class MachineError(Exception):
    def __init__(self, code: str):
        self.code = code


def machine_profile_id(provider: Provider, profile: str) -> str:
    digest = hashlib.sha256(f"{provider.name}\0{profile}".encode()).hexdigest()
    return f"{provider.name}_{digest[:24]}"


def machine_profile_label(provider: Provider, profile: str) -> str:
    if MACHINE_LABEL.fullmatch(profile):
        return profile
    return f"{provider.display} {machine_profile_id(provider, profile)[-6:]}"


def machine_time(value: Any) -> str | None:
    parsed = parse_iso_datetime(value) if isinstance(value, str) else None
    return parsed.isoformat() if parsed else None


def machine_usage(provider: Provider, profile: str, now: datetime) -> dict[str, Any]:
    cache = read_json(provider.stored_cache_path(profile), {}, strict=False)
    cache = cache if isinstance(cache, dict) else {}
    fetched = machine_time(cache.get("fetched_at"))
    attempted = machine_time(cache.get("last_attempt_at"))
    raw = cache.get("raw")
    windows = []
    if isinstance(raw, dict):
        try:
            source = usage_windows(provider, raw)
        except (AttributeError, TypeError, ValueError, OverflowError):
            source = []
        for window in source:
            key, label = window["key"], window["label"]
            if not MACHINE_WINDOW.fullmatch(key):
                # Keep the measurement without disclosing an unsafe provider label.
                key = "window." + hashlib.sha256(key.encode()).hexdigest()[:12]
                label = key
            percent = window["used_percent"]
            seconds = window["window_seconds"]
            windows.append({
                "key": key,
                "label": label if isinstance(label, str) and MACHINE_WINDOW.fullmatch(label) else key,
                "used_percent": percent if type(percent) in (int, float) and -1e308 < percent < 1e308 else None,
                "resets_at": machine_time(window["resets_at"]),
                "window_seconds": seconds if type(seconds) is int and seconds > 0 else None,
            })
    failed = cache.get("refresh_status") == "unavailable"
    age = (now - parse_iso_datetime(fetched)).total_seconds() if fetched else None
    return {
        "fetched_at": fetched,
        "last_attempt_at": attempted,
        "refresh_status": "unavailable" if failed else ("refreshed" if fetched else "unknown"),
        "stale": failed or age is None or age >= AUTO_REFRESH_SECONDS,
        "windows": windows,
    }


def machine_login_needed(provider: Provider, cred: dict[str, Any]) -> bool:
    access = credential_access_token(provider, cred)
    refresh = credential_refresh_token(provider, cred)
    return (not access and not refresh) or access_expired_without_refresh(provider, cred)


def machine_profile(provider: Provider, profile: str, active: str | None, now: datetime) -> dict[str, Any]:
    plan, login_needed = None, False
    try:
        path = provider.live_credential_path() if profile == active else provider.stored_credential_path(profile)
        cred = read_credential(provider, path)
        login_needed = machine_login_needed(provider, cred)
        meta = credential_summary(provider, cred) if provider.name == "codex" else load_profile_meta(provider, profile)
        value = (meta.get("identity") or {}).get("plan")
        if isinstance(value, str) and value.lower() in {
            "free", "go", "plus", "pro", "max", "team", "business", "enterprise",
            "education", "edu", "max_5x", "max_20x", "claude_pro", "claude_max",
        }:
            plan = value
    except SystemExit:
        login_needed = True
    except (AttributeError, TypeError, ValueError):
        pass
    billing = load_billing(provider, profile)
    if billing:
        billing = {key: billing[key] for key in ("amount", "currency", "renewal_date", "anchor_day", "interval", "note")}
    wake = load_wake(provider, profile)
    if wake:
        public = wake_public_data(wake, now)
        last_run, result = wake_result(provider, profile, wake)
        wake = {key: public[key] for key in ("enabled", "recurrence", "date", "time", "prompt", "next_run_at")}
        wake["last_run_at"] = machine_time(last_run)
        wake["last_result"] = result if isinstance(result, str) and result in {"started", "succeeded", "failed", "unknown", "already_running"} else None
    return {
        "provider": provider.name,
        "profile_id": machine_profile_id(provider, profile),
        "label": machine_profile_label(provider, profile),
        "active": profile == active,
        "plan": plan,
        "login_needed": login_needed,
        "usage": machine_usage(provider, profile, now),
        "billing": billing,
        "wake": wake,
    }


@store_operation
def machine_snapshot() -> dict[str, Any]:
    now = datetime.now().astimezone()
    totals: dict[str, Decimal] = {}
    profiles = []
    for name in MACHINE_PROVIDERS:
        provider = Provider(name)
        try:
            active = detect_active_profile(provider)
        except (AttributeError, TypeError, ValueError):
            active = None
        for profile in list_profiles(provider):
            item = machine_profile(provider, profile, active, now)
            profiles.append(item)
            billing = item["billing"]
            if billing and billing["amount"] is not None:
                currency = billing["currency"]
                totals[currency] = totals.get(currency, Decimal("0")) + Decimal(billing["amount"])
    return {"generated_at": now_iso(), "profiles": profiles, "auto_refresh_seconds": AUTO_REFRESH_SECONDS,
            "monthly_totals": {currency: f"{total:.2f}" for currency, total in sorted(totals.items())}}


def machine_params(params: dict[str, Any], keys: set[str]) -> None:
    if set(params) - keys:
        raise MachineError("invalid_params")


def machine_target(params: dict[str, Any]) -> tuple[Provider, str]:
    name, profile_id = params.get("provider"), params.get("profile_id")
    if not isinstance(name, str) or name not in MACHINE_PROVIDERS or not isinstance(profile_id, str):
        raise MachineError("invalid_params")
    provider = Provider(name)
    for profile in list_profiles(provider):
        if machine_profile_id(provider, profile) == profile_id:
            return provider, profile
    raise MachineError("profile_not_found")


def machine_refresh(params: dict[str, Any]) -> dict[str, Any]:
    machine_params(params, {"provider", "profile_id", "force"})
    force = params.get("force", True)
    if not isinstance(force, bool):
        raise MachineError("invalid_params")
    if "provider" in params or "profile_id" in params:
        targets = [machine_target(params)]
    else:
        targets = [(provider, profile) for provider in map(Provider, MACHINE_PROVIDERS)
                   for profile in list_profiles(provider)]
    results = []
    for provider, profile in targets:
        try:
            cred = profile_credential(provider, profile)
            outcome = ("login_needed" if machine_login_needed(provider, cred)
                       else refresh_profile_usage(provider, profile, force)["status"])
        except SystemExit:
            outcome = "login_needed"
        except Exception:
            outcome = "unavailable"
        results.append({"provider": provider.name, "profile_id": machine_profile_id(provider, profile),
                        "status": outcome})
    return {"profiles": results}


def machine_dispatch(method: str, params: dict[str, Any]) -> dict[str, Any]:
    if method == "snapshot":
        machine_params(params, set())
        return machine_snapshot()
    if method == "refresh":
        return machine_refresh(params)
    return machine_mutation(method, params)


@store_operation
def machine_mutation(method: str, params: dict[str, Any]) -> dict[str, Any]:
    if method not in {"billing.save", "wake.save", "wake.now", "switch"}:
        raise MachineError("unknown_method")
    payload_key = {"billing.save": "billing", "wake.save": "wake"}.get(method)
    keys = {"provider", "profile_id"}
    if payload_key:
        keys.add(payload_key)
    machine_params(params, keys)
    provider, profile = machine_target(params)
    if payload_key:
        data = params.get(payload_key)
        if not isinstance(data, dict):
            raise MachineError("invalid_params")
        if method == "billing.save":
            machine_params(data, {"amount", "currency", "renewal_date", "anchor_day", "note"})
            save_billing(provider, profile, data)
        else:
            machine_params(data, {"enabled", "recurrence", "date", "time", "prompt"})
            save_wake(provider, profile, data)
        return {"status": "saved"}
    if method == "wake.now":
        wake = load_wake(provider, profile)
        if not wake:
            raise MachineError("wake_not_configured")
        try:
            cred = profile_credential(provider, profile)
        except SystemExit:
            raise MachineError("login_needed") from None
        if machine_login_needed(provider, cred):
            raise MachineError("login_needed")
        outcome = start_wake(provider, profile, wake)
        if outcome != "started":
            raise MachineError("wake_running" if outcome == "already_running" else "wake_failed")
        return {"status": "started"}
    if env_overrides(provider):
        raise MachineError("configuration_conflict")
    # Machine switching is supported only where we can inspect sessions safely.
    if not Path("/proc/self/stat").is_file():
        raise MachineError("configuration_conflict")
    if find_active_sessions(provider, include_app_server=True):
        raise MachineError("active_sessions")
    try:
        target = read_credential(provider, provider.stored_credential_path(profile))
    except SystemExit:
        raise MachineError("login_needed") from None
    if machine_login_needed(provider, target):
        raise MachineError("login_needed")
    perform_switch_profile(provider, profile, kill_sessions=False, interactive=False)
    return {"status": "switched"}


def machine_response(line: bytes) -> dict[str, Any]:
    response = {"version": MACHINE_VERSION, "id": None}
    try:
        request = json.loads(line)
        if not isinstance(request, dict):
            raise MachineError("invalid_request")
        request_id = request.get("id")
        if not isinstance(request_id, str) or not MACHINE_ID.fullmatch(request_id):
            raise MachineError("invalid_request")
        response["id"] = request_id
        if type(request.get("version")) is not int or request["version"] != MACHINE_VERSION:
            raise MachineError("unsupported_version")
        method, params = request.get("method"), request.get("params")
        if set(request) - {"version", "id", "method", "params"} or not isinstance(method, str) or not isinstance(params, dict):
            raise MachineError("invalid_request")
        response["result"] = machine_dispatch(method, params)
    except MachineError as exc:
        response["error"] = {"code": exc.code}
    except (json.JSONDecodeError, UnicodeDecodeError, RecursionError):
        response["error"] = {"code": "invalid_request"}
    except ActiveSessionsError:
        response["error"] = {"code": "active_sessions"}
    except (ValueError, TypeError):
        response["error"] = {"code": "invalid_params"}
    except (Exception, SystemExit):
        response["error"] = {"code": "operation_failed"}
    return response


def run_machine() -> None:
    out = sys.stdout
    stop = threading.Event()
    scheduler = threading.Thread(target=run_wake_scheduler, args=(stop,), daemon=True)
    usage = threading.Thread(target=run_usage_refresh, args=(stop, MACHINE_PROVIDERS), daemon=True)
    with open(os.devnull, "w") as diagnostics, redirect_stdout(diagnostics), redirect_stderr(diagnostics):
        scheduler.start()
        usage.start()
        try:
            while line := sys.stdin.buffer.readline(MACHINE_LINE_LIMIT + 1):
                if len(line) > MACHINE_LINE_LIMIT:
                    while not line.endswith(b"\n") and (line := sys.stdin.buffer.readline(MACHINE_LINE_LIMIT + 1)):
                        pass
                    response = {"version": MACHINE_VERSION, "id": None, "error": {"code": "request_too_large"}}
                else:
                    response = machine_response(line)
                print(json.dumps(response, allow_nan=False, separators=(",", ":")), file=out, flush=True)
        except BrokenPipeError:
            pass
        finally:
            stop.set()
            scheduler.join(timeout=1)
            usage.join(timeout=1)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="accx",
        description="Switch between Claude Code and Codex CLI accounts.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"accx {VERSION}")

    sub = parser.add_subparsers(dest="provider", required=True)
    sub.add_parser("machine", help="serve the local JSONL machine interface")
    web_p = sub.add_parser("web", help="open the local account dashboard")
    web_p.add_argument("--port", type=int, default=8765, help="local port (default: 8765)")
    web_p.add_argument("--bind", default="127.0.0.1", help="bind address (default: 127.0.0.1)")
    web_p.add_argument("--no-open", action="store_true", help="do not open a browser")

    for provider_name in ("claude", "codex", "opencode"):
        p = sub.add_parser(provider_name)
        commands = p.add_subparsers(dest="command", required=True)

        list_p = commands.add_parser("list", help="list saved profiles")
        list_p.add_argument("--api", action="store_true", help="fetch live usage")

        save_p = commands.add_parser("save", help="save current account")
        save_p.add_argument("name")

        add_p = commands.add_parser("add", help="add another account without logout")
        add_p.add_argument("name")
        add_p.add_argument(
            "--kill-active",
            action="store_true",
            help="stop active CLI sessions without asking",
        )
        add_p.add_argument("login_args", nargs=argparse.REMAINDER)

        switch_p = commands.add_parser("switch", help="switch to a saved account")
        switch_p.add_argument("name")
        switch_p.add_argument(
            "--kill-active",
            action="store_true",
            help="stop active CLI sessions without asking",
        )

        identity_p = commands.add_parser("identity", help="show active account")
        identity_p.add_argument("--api", action="store_true", help="fetch live usage")

        remove_p = commands.add_parser("remove", help="remove stored profile")
        remove_p.add_argument("name")

        commands.add_parser("paths", help="show auth paths and env overrides")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.provider == "machine":
        run_machine()
        return 0
    if args.provider == "web":
        run_web_dashboard(args.port, bind=args.bind, open_browser=not args.no_open)
        return 0
    provider = Provider(args.provider)

    if provider.name == "opencode" and args.command == "add":
        import getpass
        save_opencode_key(args.name, getpass.getpass("OpenCode Go API key: "))
        return 0
    if args.command == "list":
        list_command(provider, args.api)
    elif args.command == "save":
        save_profile(provider, args.name)
    elif args.command == "add":
        login_args = list(args.login_args)
        kill_active = args.kill_active
        if "--kill-active" in login_args:
            kill_active = True
            login_args.remove("--kill-active")
        try:
            add_profile(provider, args.name, login_args, kill_active=kill_active)
        except ActiveSessionsError as exc:
            die(str(exc))
    elif args.command == "switch":
        try:
            switch_profile(provider, args.name, kill_active=args.kill_active)
        except ActiveSessionsError as exc:
            die(str(exc))
    elif args.command == "identity":
        print_identity(provider, args.api)
    elif args.command == "remove":
        remove_profile(provider, args.name)
    elif args.command == "paths":
        paths_command(provider)
    else:
        die(f"unknown command: {args.command}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
