#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


VERSION = "2.0.0"
SCHEMA_VERSION = 2


class Colors:
    def __init__(self) -> None:
        enabled = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
        self.red = "\033[1;31m" if enabled else ""
        self.green = "\033[1;32m" if enabled else ""
        self.yellow = "\033[1;33m" if enabled else ""
        self.bold = "\033[1m" if enabled else ""
        self.dim = "\033[90m" if enabled else ""
        self.off = "\033[0m" if enabled else ""


C = Colors()


def accx_home() -> Path:
    return Path(os.environ.get("ACCX_HOME", "~/.accx")).expanduser()


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def die(message: str, code: int = 1) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(code)


def warn(message: str) -> None:
    print(f"{C.yellow}WARNING:{C.off} {message}", file=sys.stderr)


def read_json(path: Path, default: Any = None, strict: bool = True) -> Any:
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as exc:
        if not strict:
            return default
        die(f"invalid JSON in {path}: {exc}")


def write_json(path: Path, data: Any, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, mode)
    tmp.replace(path)


def copy_file(src: Path, dest: Path, mode: int = 0o600) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dest)
    os.chmod(dest, mode)


def sha256_text(value: str | None) -> str | None:
    if not value:
        return None
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def short_hash(value: str | None) -> str:
    return value[:10] if value else "-"


def parse_jwt(token: str | None) -> dict[str, Any]:
    if not token or token.count(".") < 2:
        return {}
    payload = token.split(".")[1]
    payload += "=" * ((4 - len(payload) % 4) % 4)
    try:
        return json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
    except Exception:
        return {}


def epoch_to_iso(value: int | float | str | None) -> str | None:
    if value in (None, "", "null"):
        return None
    try:
        seconds = float(value)
        if seconds > 100000000000:
            seconds = seconds / 1000
        return datetime.fromtimestamp(seconds, timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    except Exception:
        return None


def ms_now() -> int:
    return int(time.time() * 1000)


def run_json_command(args: list[str], timeout: int = 8) -> dict[str, Any]:
    try:
        proc = subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return {}
    if proc.returncode != 0:
        return {}
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}


class Provider:
    def __init__(self, name: str) -> None:
        if name not in {"claude", "codex"}:
            die(f"unknown provider '{name}', expected claude or codex")
        self.name = name

    @property
    def display(self) -> str:
        return "Claude Code" if self.name == "claude" else "Codex CLI"

    @property
    def cli(self) -> str:
        return "claude" if self.name == "claude" else "codex"

    @property
    def profile_root(self) -> Path:
        return accx_home() / self.name

    def profile_dir(self, profile: str) -> Path:
        return self.profile_root / profile

    def live_credential_path(self) -> Path:
        if self.name == "claude":
            cfg = os.environ.get("CLAUDE_CONFIG_DIR")
            if cfg:
                return Path(cfg).expanduser() / ".credentials.json"
            if platform.system() == "Windows":
                return Path(os.environ.get("USERPROFILE", str(Path.home()))) / ".claude" / ".credentials.json"
            return Path.home() / ".claude" / ".credentials.json"

        codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
        return codex_home / "auth.json"

    def live_metadata_path(self) -> Path | None:
        if self.name == "claude":
            return Path.home() / ".claude.json"
        return None

    def stored_credential_path(self, profile: str) -> Path:
        pdir = self.profile_dir(profile)
        current = pdir / "credential.json"
        if current.exists():
            return current
        if self.name == "claude":
            return pdir / ".credentials.json"
        return pdir / "auth.json"

    def stored_meta_path(self, profile: str) -> Path:
        return self.profile_dir(profile) / "meta.json"

    def stored_cache_path(self, profile: str) -> Path:
        return self.profile_dir(profile) / ".usage-cache.json"

    def login_command(self, extra: list[str]) -> list[str]:
        if self.name == "claude":
            return ["claude", "auth", "login", *extra]
        return ["codex", "login", *extra]


def validate_profile_name(name: str) -> None:
    if not name:
        die("profile name is required")
    if name.startswith(".") or "/" in name or "\\" in name:
        die("profile name must not start with '.' or contain path separators")


def list_profiles(provider: Provider) -> list[str]:
    root = provider.profile_root
    if not root.exists():
        return []
    return sorted(p.name for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))


def read_credential(provider: Provider, path: Path | None = None) -> dict[str, Any]:
    path = path or provider.live_credential_path()
    data = read_json(path)
    if not isinstance(data, dict):
        die(f"{path} not found or does not contain an auth object")
    return data


def credential_refresh_token(provider: Provider, cred: dict[str, Any]) -> str | None:
    if provider.name == "claude":
        oauth = cred.get("claudeAiOauth") or {}
        return oauth.get("refreshToken")
    tokens = cred.get("tokens") or {}
    return tokens.get("refresh_token") or cred.get("refresh_token")


def credential_access_token(provider: Provider, cred: dict[str, Any]) -> str | None:
    if provider.name == "claude":
        oauth = cred.get("claudeAiOauth") or {}
        return oauth.get("accessToken")
    tokens = cred.get("tokens") or {}
    return tokens.get("access_token") or cred.get("access_token")


def credential_access_expiry_ms(provider: Provider, cred: dict[str, Any]) -> int | None:
    if provider.name == "claude":
        oauth = cred.get("claudeAiOauth") or {}
        value = oauth.get("expiresAt")
        try:
            return int(value) if value else None
        except Exception:
            return None

    tokens = cred.get("tokens") or {}
    value = tokens.get("expires_at") or cred.get("expires_at")
    if value:
        try:
            value_int = int(value)
            return value_int if value_int > 100000000000 else value_int * 1000
        except Exception:
            pass
    payload = parse_jwt(tokens.get("access_token") or cred.get("access_token"))
    exp = payload.get("exp")
    try:
        return int(exp) * 1000 if exp else None
    except Exception:
        return None


def credential_summary(provider: Provider, cred: dict[str, Any], live: bool = False, legacy_cfg: Path | None = None) -> dict[str, Any]:
    if provider.name == "claude":
        return claude_metadata(provider, cred, live=live, legacy_cfg=legacy_cfg)
    return codex_metadata(provider, cred)


def claude_metadata(provider: Provider, cred: dict[str, Any], live: bool, legacy_cfg: Path | None = None) -> dict[str, Any]:
    oauth = cred.get("claudeAiOauth") or {}
    cfg_path = legacy_cfg or provider.live_metadata_path()
    cfg = read_json(cfg_path, {}) if cfg_path else {}
    if not isinstance(cfg, dict):
        cfg = {}
    oauth_account = cfg.get("oauthAccount") if isinstance(cfg.get("oauthAccount"), dict) else {}
    status = run_json_command(["claude", "auth", "status", "--json"]) if live else {}

    email = oauth_account.get("emailAddress") or status.get("email")
    account_id = oauth_account.get("accountUuid")
    org_id = oauth_account.get("organizationUuid") or status.get("orgId")
    plan = oauth_account.get("organizationType") or status.get("subscriptionType") or oauth.get("subscriptionType")

    return {
        "schema": SCHEMA_VERSION,
        "provider": "claude",
        "saved_at": now_iso(),
        "credential": {
            "refresh_sha256": sha256_text(oauth.get("refreshToken")),
            "has_refresh": bool(oauth.get("refreshToken")),
            "access_expires_at": epoch_to_iso(oauth.get("expiresAt")),
            "rate_limit_tier": oauth.get("rateLimitTier"),
            "subscription_type": oauth.get("subscriptionType"),
        },
        "identity": {
            "email": email,
            "display_name": oauth_account.get("displayName"),
            "account_id": account_id,
            "organization_id": org_id,
            "organization_name": oauth_account.get("organizationName") or status.get("orgName"),
            "plan": plan,
            "billing": oauth_account.get("billingType"),
        },
        "claude": {
            "oauthAccount": oauth_account or None,
            "userID": cfg.get("userID"),
        },
    }


def codex_metadata(provider: Provider, cred: dict[str, Any]) -> dict[str, Any]:
    tokens = cred.get("tokens") or {}
    id_payload = parse_jwt(tokens.get("id_token") or cred.get("id_token"))
    access_payload = parse_jwt(tokens.get("access_token") or cred.get("access_token"))
    auth_claims = access_payload.get("https://api.openai.com/auth") or id_payload.get("https://api.openai.com/auth") or {}

    account_id = tokens.get("account_id") or auth_claims.get("chatgpt_account_id") or auth_claims.get("account_id")
    user_id = auth_claims.get("chatgpt_user_id") or auth_claims.get("user_id")
    plan = auth_claims.get("chatgpt_plan_type")
    email = id_payload.get("email")
    access_exp = credential_access_expiry_ms(provider, cred)

    return {
        "schema": SCHEMA_VERSION,
        "provider": "codex",
        "saved_at": now_iso(),
        "credential": {
            "refresh_sha256": sha256_text(tokens.get("refresh_token") or cred.get("refresh_token")),
            "has_refresh": bool(tokens.get("refresh_token") or cred.get("refresh_token")),
            "access_expires_at": epoch_to_iso(access_exp),
            "auth_mode": cred.get("auth_mode"),
        },
        "identity": {
            "email": email,
            "display_name": None,
            "account_id": account_id,
            "organization_id": None,
            "organization_name": None,
            "plan": plan,
            "billing": None,
            "user_id": user_id,
        },
        "codex": {
            "auth_mode": cred.get("auth_mode"),
            "last_refresh": cred.get("last_refresh"),
        },
    }


def load_profile_meta(provider: Provider, profile: str) -> dict[str, Any]:
    meta_path = provider.stored_meta_path(profile)
    meta = read_json(meta_path, None)
    if isinstance(meta, dict):
        return meta

    cred_path = provider.stored_credential_path(profile)
    if not cred_path.exists():
        return {}
    cred = read_credential(provider, cred_path)
    legacy_cfg = provider.profile_dir(profile) / ".claude.json" if provider.name == "claude" else None
    if legacy_cfg and not legacy_cfg.exists():
        legacy_cfg = None
    return credential_summary(provider, cred, live=False, legacy_cfg=legacy_cfg)


def save_profile(provider: Provider, profile: str, quiet: bool = False) -> dict[str, Any]:
    validate_profile_name(profile)
    live_path = provider.live_credential_path()
    if provider.name == "claude" and platform.system() == "Darwin" and not live_path.exists():
        die("Claude Code stores credentials in macOS Keychain on this machine; file-based switching is not available")
    if not live_path.exists():
        die(f"live auth file not found: {live_path}")

    cred = read_credential(provider, live_path)
    pdir = provider.profile_dir(profile)
    pdir.mkdir(parents=True, exist_ok=True)
    copy_file(live_path, pdir / "credential.json")
    meta = credential_summary(provider, cred, live=True)
    write_json(pdir / "meta.json", meta)

    if not quiet:
        ident = meta.get("identity") or {}
        suffix = f" ({ident.get('email')})" if ident.get("email") else ""
        print(f"Saved {provider.name} profile '{C.green}{profile}{C.off}'{suffix}")
    return meta


def profile_key(meta: dict[str, Any]) -> tuple[str | None, str | None, str | None, str | None]:
    ident = meta.get("identity") or {}
    cred = meta.get("credential") or {}
    return (
        cred.get("refresh_sha256"),
        ident.get("account_id"),
        ident.get("organization_id"),
        ident.get("email"),
    )


def is_active(provider: Provider, profile: str) -> bool:
    live_path = provider.live_credential_path()
    if not live_path.exists():
        return False
    try:
        live_cred = read_credential(provider, live_path)
    except SystemExit:
        return False
    live_meta = credential_summary(provider, live_cred, live=False)
    stored_meta = load_profile_meta(provider, profile)
    live_refresh, live_account, live_org, live_email = profile_key(live_meta)
    stored_refresh, stored_account, stored_org, stored_email = profile_key(stored_meta)

    if live_refresh and stored_refresh and live_refresh == stored_refresh:
        return True
    if stored_account and live_account and stored_account == live_account:
        if provider.name == "codex":
            return True
        if stored_org and live_org:
            return stored_org == live_org
        return True
    return bool(stored_email and live_email and stored_email == live_email and provider.name == "claude")


def detect_active_profile(provider: Provider) -> str | None:
    for profile in list_profiles(provider):
        if is_active(provider, profile):
            return profile
    return None


def update_claude_oauth_account(meta: dict[str, Any]) -> None:
    oauth = ((meta.get("claude") or {}).get("oauthAccount"))
    if not isinstance(oauth, dict) or not oauth:
        return
    cfg_path = Path.home() / ".claude.json"
    cfg = read_json(cfg_path, {})
    if not isinstance(cfg, dict):
        cfg = {}
    cfg["oauthAccount"] = oauth
    write_json(cfg_path, cfg, mode=0o600)


def backup_live_credential(provider: Provider, reason: str) -> Path | None:
    live_path = provider.live_credential_path()
    if not live_path.exists():
        return None
    backup = accx_home() / ".backups" / provider.name / f"{reason}-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    backup.mkdir(parents=True, exist_ok=True)
    copy_file(live_path, backup / live_path.name)
    return backup


def restore_live_credential(provider: Provider, backup: Path | None) -> None:
    if not backup:
        return
    live_path = provider.live_credential_path()
    saved = backup / live_path.name
    if saved.exists():
        copy_file(saved, live_path)


def switch_profile(provider: Provider, profile: str) -> None:
    validate_profile_name(profile)
    pdir = provider.profile_dir(profile)
    if not pdir.exists():
        die(f"profile '{profile}' not found")
    stored_cred = provider.stored_credential_path(profile)
    if not stored_cred.exists():
        die(f"profile '{profile}' has no stored credential file")

    current = detect_active_profile(provider)
    if current and current != profile:
        save_profile(provider, current, quiet=True)
        print(f"  {C.dim}auto-saved active profile '{current}' before switch{C.off}")

    backup_live_credential(provider, "switch")
    live_path = provider.live_credential_path()
    copy_file(stored_cred, live_path)

    meta = load_profile_meta(provider, profile)
    if provider.name == "claude":
        update_claude_oauth_account(meta)

    print(f"Switched {provider.name} to profile '{C.green}{profile}{C.off}'")
    warn_if_unusable_token(provider, read_credential(provider, live_path), profile)
    print_env_override_warnings(provider)


def hide_live_credential_for_login(provider: Provider, backup: Path) -> Path | None:
    live_path = provider.live_credential_path()
    if not live_path.exists():
        return None
    hidden = backup / "hidden-live" / live_path.name
    hidden.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(live_path), str(hidden))
    return hidden


def add_profile(provider: Provider, profile: str, login_args: list[str]) -> None:
    validate_profile_name(profile)
    if provider.profile_dir(profile).exists():
        die(f"profile '{profile}' already exists")
    if shutil.which(provider.cli) is None:
        die(f"{provider.cli} command not found in PATH")

    current = detect_active_profile(provider)
    if current:
        save_profile(provider, current, quiet=True)
        print(f"  {C.dim}saved active profile '{current}' before login{C.off}")
    else:
        print(f"  {C.dim}active {provider.name} account is not a saved profile; keeping a backup before login{C.off}")

    backup = accx_home() / ".backups" / provider.name / f"add-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    backup.mkdir(parents=True, exist_ok=True)
    live_path = provider.live_credential_path()
    if live_path.exists():
        copy_file(live_path, backup / live_path.name)
    hidden = hide_live_credential_for_login(provider, backup)

    try:
        print(f"  Starting {provider.display} login for new profile '{profile}'...")
        proc = subprocess.run(provider.login_command(login_args))
        if proc.returncode != 0:
            restore_hidden_after_failed_login(provider, hidden)
            die(f"{provider.cli} login failed")
        try:
            save_profile(provider, profile, quiet=True)
        except SystemExit:
            restore_hidden_after_failed_login(provider, hidden)
            raise
    except KeyboardInterrupt:
        restore_hidden_after_failed_login(provider, hidden)
        die("login interrupted", code=130)

    print(f"Added {provider.name} profile '{C.green}{profile}{C.off}'")
    if current:
        print(f"  {C.dim}previous profile '{current}' is saved; switch back with 'accx {provider.name} switch {current}'{C.off}")


def restore_hidden_after_failed_login(provider: Provider, hidden: Path | None) -> None:
    if not hidden or not hidden.exists():
        return
    live_path = provider.live_credential_path()
    live_path.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(hidden), str(live_path))
    os.chmod(live_path, 0o600)
    print(f"  {C.dim}restored previous {provider.name} auth{C.off}", file=sys.stderr)


def remove_profile(provider: Provider, profile: str) -> None:
    validate_profile_name(profile)
    pdir = provider.profile_dir(profile)
    if not pdir.exists():
        die(f"profile '{profile}' not found")
    if is_active(provider, profile):
        warn(f"profile '{profile}' is currently active; removing only deletes the stored copy")
    shutil.rmtree(pdir)
    print(f"Removed {provider.name} profile '{C.red}{profile}{C.off}'")


def access_expired_without_refresh(provider: Provider, cred: dict[str, Any]) -> bool:
    exp = credential_access_expiry_ms(provider, cred)
    refresh = credential_refresh_token(provider, cred)
    return bool(exp and exp < ms_now() and not refresh)


def warn_if_unusable_token(provider: Provider, cred: dict[str, Any], profile: str | None = None) -> None:
    if access_expired_without_refresh(provider, cred):
        target = f" for '{profile}'" if profile else ""
        warn(f"stored access token{target} is expired and no refresh token was found")
        if provider.name == "claude":
            print("  Run 'claude auth login', then 'accx claude save <profile>' to update it.")
        else:
            print("  Run 'codex login', then 'accx codex save <profile>' to update it.")


def env_overrides(provider: Provider) -> list[str]:
    if provider.name == "claude":
        names = [
            "CLAUDE_CODE_USE_BEDROCK",
            "CLAUDE_CODE_USE_VERTEX",
            "CLAUDE_CODE_USE_FOUNDRY",
            "ANTHROPIC_AUTH_TOKEN",
            "ANTHROPIC_API_KEY",
            "CLAUDE_CODE_OAUTH_TOKEN",
        ]
    else:
        names = ["OPENAI_API_KEY", "CODEX_ACCESS_TOKEN"]
    return [name for name in names if os.environ.get(name)]


def print_env_override_warnings(provider: Provider) -> None:
    overrides = env_overrides(provider)
    if overrides:
        warn(f"{', '.join(overrides)} is set and may take precedence over the switched profile")


def format_identity(meta: dict[str, Any]) -> str:
    ident = meta.get("identity") or {}
    email = ident.get("email") or "?"
    plan = ident.get("plan") or "?"
    account = ident.get("account_id") or "?"
    return f"{email} / {plan} / {account}"


def print_identity(provider: Provider, use_api: bool) -> None:
    live_path = provider.live_credential_path()
    if not live_path.exists():
        die(f"live auth file not found: {live_path}")
    cred = read_credential(provider, live_path)
    meta = credential_summary(provider, cred, live=True)
    ident = meta.get("identity") or {}
    credential = meta.get("credential") or {}

    print()
    print(f"  {C.bold}{provider.display} - Active Account{C.off}")
    print("  ----------------------------------------")
    print(f"  {'Email:':14} {C.bold}{ident.get('email') or '?'}{C.off}")
    if ident.get("display_name"):
        print(f"  {'Name:':14} {ident.get('display_name')}")
    print(f"  {'Plan:':14} {ident.get('plan') or '?'}")
    if ident.get("billing"):
        print(f"  {'Billing:':14} {ident.get('billing')}")
    print(f"  {'Account:':14} {ident.get('account_id') or '?'}")
    if ident.get("organization_id"):
        print(f"  {'Org:':14} {ident.get('organization_id')}")
    print(f"  {'Refresh:':14} {short_hash(credential.get('refresh_sha256'))}")
    print(f"  {'Access exp:':14} {credential.get('access_expires_at') or '?'}")

    if use_api:
        usage = fetch_usage(provider, cred)
        if usage:
            print_usage(provider, usage)
        else:
            print("  Usage:         unavailable")
    print()
    warn_if_unusable_token(provider, cred)
    print_env_override_warnings(provider)


def http_get_json(url: str, headers: dict[str, str]) -> dict[str, Any] | None:
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None


def fetch_usage(provider: Provider, cred: dict[str, Any]) -> dict[str, Any] | None:
    access = credential_access_token(provider, cred)
    if not access:
        return None
    if provider.name == "claude":
        return http_get_json(
            "https://api.anthropic.com/api/oauth/usage",
            {"Authorization": f"Bearer {access}", "anthropic-beta": "oauth-2025-04-20"},
        )
    return http_get_json(
        "https://chatgpt.com/backend-api/wham/usage",
        {"Authorization": f"Bearer {access}", "User-Agent": "Mozilla/5.0"},
    )


def print_usage(provider: Provider, usage: dict[str, Any]) -> None:
    if provider.name == "claude":
        five = usage.get("five_hour") or {}
        seven = usage.get("seven_day") or {}
        print(f"  {'5h usage:':14} {five.get('utilization', '?')}% resets {five.get('resets_at', '?')}")
        print(f"  {'7d usage:':14} {seven.get('utilization', '?')}% resets {seven.get('resets_at', '?')}")
        extra = usage.get("extra_usage") or {}
        if extra.get("monthly_limit"):
            print(f"  {'Extra:':14} {extra.get('used_credits', 0)} / {extra.get('monthly_limit')} credits")
    else:
        rate = usage.get("rate_limit") or {}
        primary = rate.get("primary_window") or {}
        secondary = rate.get("secondary_window") or {}
        print(f"  {'5h usage:':14} {primary.get('used_percent', '?')}%")
        print(f"  {'7d usage:':14} {secondary.get('used_percent', '?')}%")


def usage_cache_values(provider: Provider, profile: str, use_api: bool, cred: dict[str, Any]) -> tuple[str, str, str, str]:
    cache_path = provider.stored_cache_path(profile)
    raw = None
    if use_api:
        raw = fetch_usage(provider, cred)
        if raw:
            write_json(cache_path, {"fetched_at": now_iso(), "raw": raw})
    else:
        cache = read_json(cache_path, {}, strict=False)
        if isinstance(cache, dict):
            raw = cache.get("raw")
    if not isinstance(raw, dict):
        return "?", "?", "?", "?"
    if provider.name == "claude":
        five = raw.get("five_hour") or {}
        seven = raw.get("seven_day") or {}
        return (
            str(five.get("utilization", "?")),
            str(seven.get("utilization", "?")),
            str(five.get("resets_at", "?"))[:16],
            str(seven.get("resets_at", "?"))[:16],
        )
    rate = raw.get("rate_limit") or {}
    primary = rate.get("primary_window") or {}
    secondary = rate.get("secondary_window") or {}
    return (
        str(primary.get("used_percent", "?")),
        str(secondary.get("used_percent", "?")),
        str(primary.get("reset_at", "?")),
        str(secondary.get("reset_at", "?")),
    )


def list_command(provider: Provider, use_api: bool) -> None:
    profiles = list_profiles(provider)
    if not profiles:
        print()
        print(f"  No saved {provider.name} profiles.")
        print(f"  Use 'accx {provider.name} save <name>' to save the current account.")
        print()
        return

    active = detect_active_profile(provider)
    print()
    print(f"  {C.bold}{'PROFILE':14} {'EMAIL':28} {'PLAN':10} {'EXP':20} {'5H%':>6} {'7D%':>6}{C.off}")
    for profile in profiles:
        cred_path = provider.stored_credential_path(profile)
        if not cred_path.exists():
            continue
        cred = read_credential(provider, cred_path)
        meta = load_profile_meta(provider, profile)
        ident = meta.get("identity") or {}
        cmeta = meta.get("credential") or {}
        p5, p7, _, _ = usage_cache_values(provider, profile, use_api, cred)
        marker = "*" if profile == active else " "
        email = (ident.get("email") or "?")[:28]
        plan = (ident.get("plan") or "?")[:10]
        exp = (cmeta.get("access_expires_at") or "?")[:20]
        print(f"  {marker}{profile[:13]:13} {C.dim}{email:28}{C.off} {plan:10} {exp:20} {p5:>5}% {p7:>5}%")
    print()
    if active:
        print("  * = active profile")
    print("  Refreshed via API" if use_api else "  Using cache; add --api to refresh")
    print()


def paths_command(provider: Provider) -> None:
    print()
    print(f"  {C.bold}{provider.display} paths{C.off}")
    print("  ----------------------------------------")
    print(f"  {'Live auth:':14} {provider.live_credential_path()}")
    meta_path = provider.live_metadata_path()
    if meta_path:
        print(f"  {'Live meta:':14} {meta_path} (only oauthAccount is touched)")
    print(f"  {'Vault:':14} {provider.profile_root}")
    overrides = env_overrides(provider)
    print(f"  {'Env override:':14} {', '.join(overrides) if overrides else '-'}")
    if provider.name == "claude" and platform.system() == "Darwin":
        print("  Note: Claude Code stores OAuth credentials in macOS Keychain by default.")
    print()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="accx",
        description="Switch between Claude Code and Codex CLI accounts.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"accx {VERSION}")

    sub = parser.add_subparsers(dest="provider", required=True)
    for provider_name in ("claude", "codex"):
        p = sub.add_parser(provider_name)
        commands = p.add_subparsers(dest="command", required=True)

        list_p = commands.add_parser("list", help="list saved profiles")
        list_p.add_argument("--api", action="store_true", help="fetch live usage")

        save_p = commands.add_parser("save", help="save current account")
        save_p.add_argument("name")

        add_p = commands.add_parser("add", help="add another account without logout")
        add_p.add_argument("name")
        add_p.add_argument("login_args", nargs=argparse.REMAINDER)

        switch_p = commands.add_parser("switch", help="switch to a saved account")
        switch_p.add_argument("name")

        identity_p = commands.add_parser("identity", help="show active account")
        identity_p.add_argument("--api", action="store_true", help="fetch live usage")

        remove_p = commands.add_parser("remove", help="remove stored profile")
        remove_p.add_argument("name")

        commands.add_parser("paths", help="show auth paths and env overrides")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    provider = Provider(args.provider)

    if args.command == "list":
        list_command(provider, args.api)
    elif args.command == "save":
        save_profile(provider, args.name)
    elif args.command == "add":
        add_profile(provider, args.name, args.login_args)
    elif args.command == "switch":
        switch_profile(provider, args.name)
    elif args.command == "identity":
        print_identity(provider, args.api)
    elif args.command == "remove":
        remove_profile(provider, args.name)
    elif args.command == "paths":
        paths_command(provider)
    else:
        die(f"unknown command: {args.command}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
