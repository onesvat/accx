def accx_home() -> Path:
    return Path(os.environ.get("ACCX_HOME", "~/.accx")).expanduser()


@contextmanager
def file_lock(name: str, blocking: bool = True):
    home = accx_home()
    home.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(home / name, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            if os.name == "nt":
                msvcrt.locking(fd, msvcrt.LK_LOCK if blocking else msvcrt.LK_NBLCK, 1)
            else:
                fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except OSError as exc:
            if blocking or (not isinstance(exc, BlockingIOError) and os.name != "nt"):
                raise
            yield False
        else:
            yield True
    finally:
        os.close(fd)


@contextmanager
def store_lock():
    with STORE_LOCK:
        if getattr(STORE_SCOPE, "locked", False):
            yield
            return
        with file_lock(".store.lock"):
            STORE_SCOPE.locked = True
            try:
                yield
            finally:
                STORE_SCOPE.locked = False


def store_operation(func):
    @functools.wraps(func)
    def locked(*args, **kwargs):
        with store_lock():
            return func(*args, **kwargs)

    return locked


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def wake_log(event: str, **details: Any) -> None:
    entry = {"timestamp": now_iso(), "event": event, **details}
    path = accx_home() / "wake.log"
    try:
        with WAKE_LOG_LOCK:
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.open("a", encoding="utf-8") as log_file:
                log_file.write(json.dumps(entry, sort_keys=True, default=str) + "\n")
            os.chmod(path, 0o600)
    except (OSError, TypeError, ValueError) as exc:
        print(f"Auto wake log write failed: {exc}", file=sys.stderr)


def desktop_notify(title: str, body: str, urgency: str = "normal") -> bool:
    if os.environ.get("ACCX_DESKTOP_NOTIFY", "").strip().lower() in {"0", "false", "no", "off"}:
        return False
    command = shutil.which("notify-send")
    if not command:
        return False
    try:
        subprocess.run(
            [command, "-a", "accx", "-u", urgency, "-t", "10000", title, body],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        return True
    except (OSError, subprocess.SubprocessError):
        return False


