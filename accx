def http_get_json(url: str, headers: dict[str, str]) -> dict[str, Any] | None:
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None


def http_post_form_json(url: str, form: dict[str, str]) -> dict[str, Any] | None:
    body = urllib.parse.urlencode(form).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None


def refresh_codex_credential(cred: dict[str, Any]) -> bool:
    refresh = credential_refresh_token(Provider("codex"), cred)
    if not refresh:
        return False
    response = http_post_form_json(
        CODEX_TOKEN_URL,
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "client_id": CODEX_CLIENT_ID,
        },
    )
    if not isinstance(response, dict) or not response.get("access_token"):
        return False

    tokens = cred.setdefault("tokens", {})
    tokens["access_token"] = response["access_token"]
    if response.get("refresh_token"):
        tokens["refresh_token"] = response["refresh_token"]
    if response.get("id_token"):
        tokens["id_token"] = response["id_token"]
    cred["last_refresh"] = now_iso()
    return True


def codex_token_needs_refresh(cred: dict[str, Any]) -> bool:
    expiry = credential_access_expiry_ms(Provider("codex"), cred)
    return expiry is not None and expiry <= ms_now() + 60_000


def fetch_usage(provider: Provider, cred: dict[str, Any]) -> dict[str, Any] | None:
    access = credential_access_token(provider, cred)
    if not access:
        return None
    if provider.name == "claude":
        return http_get_json(
            "https://api.anthropic.com/api/oauth/usage",
            {"Authorization": f"Bearer {access}", "anthropic-beta": "oauth-2025-04-20"},
        )
    if provider.name == "opencode":
        return http_get_json("https://opencode.ai/zen/go/v1/usage", {"Authorization": f"Bearer {access}", "User-Agent": "accx/" + VERSION})
    headers = {"Authorization": f"Bearer {access}", "User-Agent": "codex-cli"}
    account_id = codex_account_id(cred)
    if account_id:
        headers["ChatGPT-Account-Id"] = account_id
    return http_get_json("https://chatgpt.com/backend-api/wham/usage", headers)


def usage_windows(provider: Provider, raw: dict[str, Any]) -> list[dict[str, Any]]:
    """Preserve every usage window returned by the provider, including new models."""
    windows = []

    def add(key: str, value: Any, percent_key: str, reset_key: str) -> None:
        if not isinstance(value, dict):
            return
        if percent_key not in value and reset_key not in value:
            return
        windows.append({
            "key": key,
            "label": key.replace("_", " "),
            "used_percent": value.get(percent_key),
            "resets_at": reset_value_to_iso(value.get(reset_key)),
            "window_seconds": value.get("limit_window_seconds"),
        })

    if provider.name == "opencode":
        for name, key in (("rolling", "five_hour"), ("weekly", "seven_day"), ("monthly", "monthly")):
            add(key, (raw.get("usage") or {}).get(name), "percent", "resetsAt")
        for window in windows:
            window["label"] = {"five_hour": "5 saat", "seven_day": "7 gün", "monthly": "Aylık"}[window["key"]]
    elif provider.name == "claude":
        for key, value in raw.items():
            if key != "extra_usage":
                add(key, value, "utilization", "resets_at")
        limits = raw.get("limits")
        for index, limit in enumerate(limits if isinstance(limits, list) else []):
            if not isinstance(limit, dict):
                continue
            kind = limit.get("kind")
            kind = kind if isinstance(kind, str) else "unknown"
            key = {"session": "five_hour", "weekly_all": "seven_day"}.get(kind)
            if key and any(window["key"] == key for window in windows):
                continue
            scope = limit.get("scope")
            scope = scope if isinstance(scope, dict) else {}
            model = scope.get("model")
            model = model if isinstance(model, dict) else {}
            names = (model.get("display_name"), model.get("id"), scope.get("surface"), kind)
            name = next((text for text in names if isinstance(text, str) and text), str(index))
            key = key or f"limits.{kind}.{name}"
            add(key, {"utilization": limit.get("percent"), "resets_at": limit.get("resets_at")}, "utilization", "resets_at")
            windows[-1]["label"] = f"{name} · 7 gün" if limit.get("group") == "weekly" else str(name)
    else:
        def add_rate(key: str, rate: Any) -> None:
            if isinstance(rate, dict):
                for window, value in rate.items():
                    add(f"{key}.{window}", value, "used_percent", "reset_at")

        for key, value in raw.items():
            if isinstance(value, dict):
                add_rate(key, value)
            elif key == "additional_rate_limits" and isinstance(value, list):
                for index, entry in enumerate(value):
                    if isinstance(entry, dict):
                        name = str(entry.get("limit_name") or entry.get("metered_feature") or index)
                        add_rate(f"additional_rate_limits.{name}", entry.get("rate_limit") or entry)
    return windows


def print_usage(provider: Provider, usage: dict[str, Any]) -> None:
    for window in usage_windows(provider, usage):
        print(f"  {window['label']}: {window['used_percent']}% resets {format_reset_time(window['resets_at'])}")
    extra = usage.get("extra_usage") or {}
    if extra.get("monthly_limit"):
        print(f"  {'Extra:':14} {extra.get('used_credits', 0)} / {extra.get('monthly_limit')} credits")


def format_usage_percent(value: Any, width: int = 8) -> str:
    label = f"{value}%"
    try:
        used = float(value)
    except (TypeError, ValueError):
        style = C.dim
    else:
        if not math.isfinite(used) or used <= 0:
            style = C.dim
        elif used >= 100:
            style = f"{C.red}{C.strike}"
        elif used >= 80:
            style = C.red
        elif used >= 60:
            style = C.yellow
        else:
            style = ""
    padding = " " * max(width - len(label), 0)
    if not style:
        return f"{padding}{label}"
    return f"{padding}{style}{label}{C.off}"


def reset_value_to_iso(value: Any) -> str | None:
    if value in (None, "", "?"):
        return None
    if isinstance(value, (int, float)):
        return epoch_to_iso(value)
    parsed = parse_iso_datetime(str(value))
    return parsed.astimezone(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z") if parsed else str(value)


def format_reset_time(value: Any, now: datetime | None = None) -> str:
    normalized = reset_value_to_iso(value)
    parsed = parse_iso_datetime(normalized)
    if parsed is None:
        return "?"
    reset = parsed.astimezone()
    current = (now or datetime.now().astimezone()).astimezone()
    if reset.date() != current.date():
        return reset.strftime("%Y-%m-%d %H:%M")
    absolute = reset.strftime("%H:%M")
    remaining_seconds = (reset - current).total_seconds()
    if remaining_seconds <= 0:
        return absolute
    remaining_minutes = math.ceil(remaining_seconds / 60)
    hours, minutes = divmod(remaining_minutes, 60)
    parts = ([f"{hours}h"] if hours else []) + ([f"{minutes}m"] if minutes else [])
    return f"{absolute} ({' '.join(parts)})"


def usage_snapshot(provider: Provider, raw: dict[str, Any], recorded_at: str | None = None) -> dict[str, Any]:
    if provider.name == "opencode":
        windows = usage_windows(provider, raw)
        by_key = {window["key"]: window for window in windows}
        return {"recorded_at": recorded_at or now_iso(), "windows": windows,
                **{key: by_key.get(key, {}).get("used_percent") for key in ("five_hour", "seven_day")},
                **{key + "_resets_at": by_key.get(key, {}).get("resets_at") for key in ("five_hour", "seven_day")}}
    if provider.name == "claude":
        five = raw.get("five_hour") or {}
        seven = raw.get("seven_day") or {}
        extra = raw.get("extra_usage") or {}
        return {
            "recorded_at": recorded_at or now_iso(),
            "windows": usage_windows(provider, raw),
            "five_hour": five.get("utilization"),
            "seven_day": seven.get("utilization"),
            "five_hour_resets_at": reset_value_to_iso(five.get("resets_at")),
            "seven_day_resets_at": reset_value_to_iso(seven.get("resets_at")),
            "extra_usage": {
                "enabled": bool(extra.get("is_enabled")),
                "used_credits": extra.get("used_credits"),
                "monthly_limit": extra.get("monthly_limit"),
                "currency": extra.get("currency"),
            },
        }

    rate = raw.get("rate_limit") or {}
    primary = rate.get("primary_window") or {}
    secondary = rate.get("secondary_window") or {}
    return {
        "recorded_at": recorded_at or now_iso(),
        "windows": usage_windows(provider, raw),
        "five_hour": primary.get("used_percent"),
        "seven_day": secondary.get("used_percent"),
        "five_hour_resets_at": reset_value_to_iso(primary.get("reset_at")),
        "seven_day_resets_at": reset_value_to_iso(secondary.get("reset_at")),
        "reset_credits": raw.get("rate_limit_reset_credits"),
        "credits": raw.get("credits"),
        "allowed": rate.get("allowed"),
        "limit_reached": rate.get("limit_reached"),
    }


def load_usage_cache(provider: Provider, profile: str) -> tuple[dict[str, Any] | None, str | None]:
    cache = read_json(provider.stored_cache_path(profile), {}, strict=False)
    if not isinstance(cache, dict) or not isinstance(cache.get("raw"), dict):
        return None, None
    return cache["raw"], cache.get("fetched_at")


def notify_state_path() -> Path:
    return accx_home() / "notify-state.json"


def load_notify_state() -> dict[str, Any]:
    state = read_json(notify_state_path(), {}, strict=False)
    if not isinstance(state, dict):
        state = {}
    sent = state.get("sent")
    if not isinstance(sent, dict):
        sent = {}
    pending = state.get("pending")
    if not isinstance(pending, dict):
        pending = {}
    return {"schema": NOTIFY_STATE_SCHEMA, "sent": sent, "pending": pending}


def process_due_notifications(now: datetime | None = None) -> list[dict[str, Any]]:
    current = now or datetime.now(timezone.utc)
    if current.tzinfo is None:
        current = current.replace(tzinfo=timezone.utc)
    current = current.astimezone(timezone.utc)
    state = load_notify_state()
    sent = state["sent"]
    pending = state["pending"]
    changed = False
    results: list[dict[str, Any]] = []

    for provider_name in ("claude", "codex"):
        provider = Provider(provider_name)
        for profile in list_profiles(provider):
            raw, fetched_at = load_usage_cache(provider, profile)
            if not raw:
                continue
            snapshot = usage_snapshot(provider, raw, recorded_at=fetched_at)
            for label, usage_key, reset_key in (
                ("5 saatlik limit", "five_hour", "five_hour_resets_at"),
                ("7 günlük limit", "seven_day", "seven_day_resets_at"),
            ):
                reset_value = snapshot.get(reset_key)
                reset = parse_iso_datetime(reset_value)
                if reset is None:
                    continue
                reset = reset.astimezone(timezone.utc)
                sent_key = f"{provider.name}:{profile}:{reset_key}:{reset.isoformat()}"
                if sent_key in sent:
                    continue
                for pending_key, item in list(pending.items()):
                    if (
                        item.get("provider") == provider.name
                        and item.get("profile") == profile
                        and item.get("window") == usage_key
                        and pending_key != sent_key
                    ):
                        old_reset = parse_iso_datetime(item.get("reset_at"))
                        if old_reset and old_reset.astimezone(timezone.utc) > current:
                            del pending[pending_key]
                            changed = True
                try:
                    usage = float(snapshot.get(usage_key))
                except (TypeError, ValueError):
                    usage = None
                if usage is not None and usage >= NOTIFY_MIN_USAGE:
                    if sent_key not in pending:
                        pending[sent_key] = {
                            "provider": provider.name,
                            "profile": profile,
                            "window": usage_key,
                            "label": label,
                            "reset_at": reset.isoformat(),
                        }
                        changed = True

    for pending_key, item in list(pending.items()):
        reset = parse_iso_datetime(item.get("reset_at"))
        if reset is None:
            del pending[pending_key]
            changed = True
            continue
        reset = reset.astimezone(timezone.utc)
        if reset > current:
            continue
        if pending_key in sent:
            del pending[pending_key]
            changed = True
            continue
        age = (current - reset).total_seconds()
        if age <= NOTIFY_GRACE_SECONDS:
            provider = Provider(str(item.get("provider") or "claude"))
            label = str(item.get("label") or item.get("window") or "limit")
            body = f"{item.get('profile')} · {format_reset_time(reset.isoformat(), now=current)}"
            if desktop_notify(f"{provider.display}: {label} sıfırlandı", body):
                wake_log(
                    "desktop_notified",
                    provider=provider.name,
                    profile=item.get("profile"),
                    window=item.get("window"),
                    reset_at=reset.isoformat(),
                )
                results.append(
                    {
                        "provider": provider.name,
                        "profile": item.get("profile"),
                        "window": item.get("window"),
                        "reset_at": reset.isoformat(),
                    }
                )
        sent[pending_key] = now_iso()
        del pending[pending_key]
        changed = True

    cutoff = current - timedelta(days=45)
    for key, timestamp in list(sent.items()):
        parsed = parse_iso_datetime(timestamp)
        if parsed and parsed.astimezone(timezone.utc) < cutoff:
            del sent[key]
            changed = True
    for key, item in list(pending.items()):
        parsed = parse_iso_datetime(item.get("reset_at"))
        if parsed and parsed.astimezone(timezone.utc) < cutoff:
            del pending[key]
            changed = True
    if changed:
        state["schema"] = NOTIFY_STATE_SCHEMA
        write_json(notify_state_path(), state)
    return results


def renewal_for_month(year: int, month: int, anchor_day: int):
    return datetime(year, month, min(anchor_day, calendar.monthrange(year, month)[1])).date()


def advance_monthly_renewal(value: str, anchor_day: int, today=None) -> str:
    try:
        current = datetime.strptime(value, "%Y-%m-%d").date()
    except ValueError as exc:
        raise ValueError("renewal_date must use YYYY-MM-DD") from exc
    today = today or local_today()
    while current < today:
        year = current.year + (1 if current.month == 12 else 0)
        month = 1 if current.month == 12 else current.month + 1
        current = renewal_for_month(year, month, anchor_day)
    return current.isoformat()


def normalize_billing_input(data: dict[str, Any], today=None) -> dict[str, Any]:
    renewal_date = str(data.get("renewal_date") or "").strip()
    if not renewal_date:
        raise ValueError("renewal_date is required")
    try:
        parsed_date = datetime.strptime(renewal_date, "%Y-%m-%d").date()
    except ValueError as exc:
        raise ValueError("renewal_date must use YYYY-MM-DD") from exc
    try:
        anchor_day = int(data.get("anchor_day") or parsed_date.day)
    except (TypeError, ValueError) as exc:
        raise ValueError("anchor_day must be a day of month") from exc
    if not 1 <= anchor_day <= 31:
        raise ValueError("anchor_day must be between 1 and 31")

    amount_value = data.get("amount")
    amount = None
    currency = str(data.get("currency") or "").strip().upper()
    if amount_value not in (None, ""):
        try:
            decimal_amount = Decimal(str(amount_value))
        except InvalidOperation as exc:
            raise ValueError("amount must be a number") from exc
        if not decimal_amount.is_finite() or decimal_amount < 0:
            raise ValueError("amount must be zero or greater")
        if decimal_amount.as_tuple().exponent < -2:
            raise ValueError("amount supports at most two decimal places")
        if decimal_amount > Decimal("9999999999.99"):
            raise ValueError("amount is too large")
        if len(currency) != 3 or not currency.isalpha():
            raise ValueError("currency must be a three-letter code")
        amount = f"{decimal_amount:.2f}"
    elif currency and (len(currency) != 3 or not currency.isalpha()):
        raise ValueError("currency must be a three-letter code")

    note_value = data.get("note")
    if note_value not in (None, "") and not isinstance(note_value, str):
        raise ValueError("note must be text")
    note = str(note_value or "").strip()
    if len(note) > 500:
        raise ValueError("note must be 500 characters or fewer")

    return {
        "renewal_date": advance_monthly_renewal(renewal_date, anchor_day, today=today),
        "amount": amount,
        "currency": currency if amount is not None else None,
        "interval": "monthly",
        "anchor_day": anchor_day,
        "note": note or None,
    }


@store_operation
def load_billing(provider: Provider, profile: str) -> dict[str, Any] | None:
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    if not isinstance(settings, dict) or not isinstance(settings.get("billing"), dict):
        return None
    original = settings["billing"]
    try:
        billing = normalize_billing_input(original)
    except ValueError:
        return None
    if billing != original:
        settings["schema"] = WEB_SCHEMA_VERSION
        settings["billing"] = billing
        write_json(path, settings)
    return billing


@store_operation
def save_billing(provider: Provider, profile: str, data: dict[str, Any]) -> dict[str, Any]:
    if profile not in list_profiles(provider):
        raise ValueError(f"profile '{profile}' not found")
    billing = normalize_billing_input(data)
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    if not isinstance(settings, dict):
        settings = {}
    settings["schema"] = WEB_SCHEMA_VERSION
    settings["billing"] = billing
    write_json(path, settings)
    return billing


def normalize_wake_input(data: dict[str, Any]) -> dict[str, Any]:
    enabled = data.get("enabled", True)
    if not isinstance(enabled, bool):
        raise ValueError("enabled must be a boolean")
    recurrence = str(data.get("recurrence") or "").strip()
    if recurrence not in {"once", "daily"}:
        raise ValueError("recurrence must be once or daily")
    time_value = str(data.get("time") or "").strip()
    try:
        datetime.strptime(time_value, "%H:%M")
    except ValueError as exc:
        raise ValueError("time must use HH:MM") from exc
    date_value = str(data.get("date") or "").strip() or None
    if recurrence == "once":
        try:
            datetime.strptime(date_value or "", "%Y-%m-%d")
        except ValueError as exc:
            raise ValueError("date must use YYYY-MM-DD for a one-time wake") from exc
    prompt = data.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        raise ValueError("prompt is required")
    prompt = prompt.strip()
    if len(prompt) > 4000:
        raise ValueError("prompt must be 4000 characters or fewer")
    return {
        "enabled": enabled,
        "recurrence": recurrence,
        "date": date_value if recurrence == "once" else None,
        "time": time_value,
        "prompt": prompt,
        "last_run_at": data.get("last_run_at") if isinstance(data.get("last_run_at"), str) else None,
        "last_result": data.get("last_result") if isinstance(data.get("last_result"), str) else None,
        "last_attempt_at": data.get("last_attempt_at") if isinstance(data.get("last_attempt_at"), str) else None,
    }


def wake_candidate(wake: dict[str, Any], now: datetime | None = None) -> datetime | None:
    if not wake.get("enabled"):
        return None
    now = now or datetime.now().astimezone()
    hour, minute = (int(part) for part in wake["time"].split(":"))
    if wake["recurrence"] == "once":
        target_date = datetime.strptime(wake["date"], "%Y-%m-%d").date()
        candidate = datetime.combine(target_date, datetime.min.time(), tzinfo=now.tzinfo).replace(hour=hour, minute=minute)
        return candidate
    candidate = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    last_run = parse_iso_datetime(wake.get("last_run_at"))
    if last_run:
        last_run = last_run.astimezone(now.tzinfo)
    if candidate <= now and last_run and last_run >= candidate:
        candidate += timedelta(days=1)
    return candidate


def wake_public_data(wake: dict[str, Any] | None, now: datetime | None = None) -> dict[str, Any] | None:
    if not wake:
        return None
    now = now or datetime.now().astimezone()
    candidate = wake_candidate(wake, now=now)
    if candidate and candidate <= now:
        candidate = candidate + timedelta(days=1) if wake["recurrence"] == "daily" else None
    result = dict(wake)
    result["next_run_at"] = candidate.isoformat() if candidate else None
    result["expected_reset_at"] = (candidate + timedelta(hours=5)).isoformat() if candidate else None
    return result


def load_wake(provider: Provider, profile: str) -> dict[str, Any] | None:
    settings = read_json(provider.stored_settings_path(profile), {}, strict=False)
    if not isinstance(settings, dict) or not isinstance(settings.get("wake"), dict):
        return None
    try:
        return normalize_wake_input(settings["wake"])
    except ValueError as exc:
        wake_log("schedule_invalid", provider=provider.name, profile=profile, error=str(exc))
        return None


@store_operation
def save_wake(provider: Provider, profile: str, data: dict[str, Any]) -> dict[str, Any]:
    if profile not in list_profiles(provider):
        raise ValueError(f"profile '{profile}' not found")
    wake = normalize_wake_input({key: data.get(key) for key in ("recurrence", "date", "time", "prompt")} | {"enabled": data.get("enabled", True)})
    current = load_wake(provider, profile)
    schedule_changed = not current or any(current.get(key) != wake.get(key) for key in ("recurrence", "date", "time"))
    if current and not schedule_changed:
        wake["last_run_at"] = current.get("last_run_at")
        wake["last_result"] = current.get("last_result")
        wake["last_attempt_at"] = current.get("last_attempt_at")
    elif wake["recurrence"] == "daily":
        now = datetime.now().astimezone()
        candidate = wake_candidate(wake, now=now)
        if candidate and candidate <= now:
            wake["last_run_at"] = now.isoformat()
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    if not isinstance(settings, dict):
        settings = {}
    settings["schema"] = WEB_SCHEMA_VERSION
    settings["wake"] = wake
    write_json(path, settings)
    wake_log(
        "schedule_saved",
        provider=provider.name,
        profile=profile,
        enabled=wake["enabled"],
        recurrence=wake["recurrence"],
        date=wake["date"],
        time=wake["time"],
    )
    return wake


def wake_command(provider: Provider, prompt: str) -> list[str]:
    if provider.name == "claude":
        return ["claude", "-p", "--model", "haiku", "--", prompt]
    return [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "--model",
        "gpt-5.1-codex-mini",
        "--",
        prompt,
    ]


def wake_runtime_state(provider: Provider, profile: str) -> dict[str, Any]:
    path = provider.profile_dir(profile) / ".wake-runtime" / "state.json"
    state = read_json(path, {}, strict=False)
    return state if isinstance(state, dict) else {}


def wake_is_running(state: dict[str, Any]) -> bool:
    pid, started = state.get("pid"), state.get("start_time")
    return isinstance(pid, int) and isinstance(started, int) and _same_process(pid, started)


def wake_result(provider: Provider, profile: str, wake: dict[str, Any]) -> tuple[str | None, str | None]:
    state = wake_runtime_state(provider, profile)
    run_at = parse_iso_datetime(state.get("last_run_at"))
    scheduled_attempt = parse_iso_datetime(wake.get("last_attempt_at"))
    if run_at and (not scheduled_attempt or run_at >= scheduled_attempt):
        result = state.get("last_result")
        if result == "started" and not wake_is_running(state):
            result = "unknown"
        return state["last_run_at"], result
    result = wake.get("last_result")
    if isinstance(result, str) and result.startswith("failed:"):
        result = "failed"
    return wake.get("last_run_at"), result


@store_operation
def start_wake(
    provider: Provider,
    profile: str,
    wake: dict[str, Any],
    notify: bool = True,
) -> str:
    if shutil.which(provider.cli) is None:
        result = f"failed: {provider.cli} command not found"
        wake_log("wake_failed", provider=provider.name, profile=profile, error=result)
        if notify:
            desktop_notify(
                "accx: uyandırma başarısız",
                f"{provider.display} · {profile}\n{result}",
                urgency="critical",
            )
        return result
    runtime_dir = provider.profile_dir(profile) / ".wake-runtime"
    runtime_dir.mkdir(parents=True, exist_ok=True)
    state_path = runtime_dir / "state.json"
    if wake_is_running(wake_runtime_state(provider, profile)):
        return "already_running"
    output_path = runtime_dir / "wake.log"
    credential_name = ".credentials.json" if provider.name == "claude" else "auth.json"
    copy_file(provider.stored_credential_path(profile), runtime_dir / credential_name)
    env = os.environ.copy()
    for name in env_overrides(provider):
        env.pop(name, None)
    if provider.name == "claude":
        env["CLAUDE_CONFIG_DIR"] = str(runtime_dir)
    else:
        source_config = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser() / "config.toml"
        if source_config.exists():
            copy_file(source_config, runtime_dir / "config.toml")
        env["CODEX_HOME"] = str(runtime_dir)
    try:
        with output_path.open("ab") as output:
            process = subprocess.Popen(
                wake_command(provider, wake["prompt"]),
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
    except OSError as exc:
        result = f"failed: {exc}"
        wake_log("wake_failed", provider=provider.name, profile=profile, error=result)
        if notify:
            desktop_notify(
                "accx: uyandırma başarısız",
                f"{provider.display} · {profile}\n{exc}",
                urgency="critical",
            )
        return result
    wake_log(
        "wake_started",
        provider=provider.name,
        profile=profile,
        pid=process.pid,
        output=str(output_path),
    )

    execution = secrets.token_hex(16)
    if isinstance(process.pid, int):
        write_json(state_path, {"execution": execution, "pid": process.pid,
                               "start_time": _proc_start_time(process.pid),
                               "last_run_at": datetime.now(timezone.utc).isoformat(),
                               "last_result": "started"})

    def record_completion() -> None:
        exit_code = process.wait()
        with store_lock():
            state = wake_runtime_state(provider, profile)
            if state.get("execution") == execution:
                state["last_result"] = "succeeded" if exit_code == 0 else "failed"
                write_json(state_path, state)
        wake_log(
            "wake_completed",
            provider=provider.name,
            profile=profile,
            pid=process.pid,
            exit_code=exit_code,
            output=str(output_path),
        )
        if notify:
            if exit_code == 0:
                desktop_notify(
                    "accx: uyandırma tamamlandı",
                    f"{provider.display} · {profile}",
                )
            else:
                desktop_notify(
                    "accx: uyandırma başarısız",
                    f"{provider.display} · {profile} (çıkış {exit_code})",
                    urgency="critical",
                )

    if isinstance(process.pid, int):
        threading.Thread(target=record_completion, name=f"accx-wake-{process.pid}", daemon=True).start()
    return "started"


def write_wake(provider: Provider, profile: str, wake: dict[str, Any]) -> None:
    path = provider.stored_settings_path(profile)
    settings = read_json(path, {}, strict=False)
    settings = settings if isinstance(settings, dict) else {}
    settings.update(schema=WEB_SCHEMA_VERSION, wake=wake)
    write_json(path, settings)


@store_operation
def process_due_wakes(now: datetime, since: datetime) -> list[dict[str, Any]]:
    results = []
    for provider_name in MACHINE_PROVIDERS:
        provider = Provider(provider_name)
        for profile in list_profiles(provider):
            try:
                wake = load_wake(provider, profile)
                if not wake:
                    continue
                candidate = wake_candidate(wake, now=now)
                attempted = parse_iso_datetime(wake.get("last_attempt_at"))
                if not candidate or not since < candidate <= now or (attempted and attempted >= candidate):
                    continue
                # Persist delivery before launching so a takeover cannot run this occurrence twice.
                wake.update(last_attempt_at=candidate.isoformat(), last_result="unknown")
                write_wake(provider, profile, wake)
                wake_log("wake_due", provider=provider_name, profile=profile, scheduled_at=candidate.isoformat())
                result = start_wake(provider, profile, wake)
                wake["last_result"] = result
                if result == "started":
                    wake["last_run_at"] = now.isoformat()
                    if wake["recurrence"] == "once":
                        wake["enabled"] = False
                write_wake(provider, profile, wake)
                results.append({"provider": provider_name, "profile": profile, "result": result})
            except Exception as exc:
                wake_log("wake_check_failed", provider=provider_name, profile=profile, error=str(exc))
    return results


def read_text_tail(path: Path, max_bytes: int = 65536) -> str:
    try:
        with path.open("rb") as source:
            source.seek(0, os.SEEK_END)
            size = source.tell()
            source.seek(max(0, size - max_bytes))
            data = source.read()
    except OSError:
        return ""
    text = data.decode("utf-8", errors="replace")
    if size > max_bytes and "\n" in text:
        text = text.split("\n", 1)[1]
    return text.rstrip()


def wake_monitor_data(event_limit: int = 200) -> dict[str, Any]:
    plans = []
    for provider_name in ("claude", "codex"):
        provider = Provider(provider_name)
        for profile in list_profiles(provider):
            wake = load_wake(provider, profile)
            if not wake:
                continue
            public = wake_public_data(wake) or {}
            plans.append({
                "provider": provider_name,
                "profile": profile,
                "model": "haiku" if provider_name == "claude" else "gpt-5.1-codex-mini",
                "output": read_text_tail(provider.profile_dir(profile) / ".wake-runtime" / "wake.log"),
                **public,
            })

    events = []
    for line in read_text_tail(accx_home() / "wake.log", max_bytes=256 * 1024).splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict):
            events.append(event)
    return {
        "generated_at": now_iso(),
        "plans": plans,
        "events": list(reversed(events[-event_limit:])),
    }


@store_operation
def usage_cache_values(
    provider: Provider,
    profile: str,
    use_api: bool,
    cred: dict[str, Any],
    active: bool = False,
) -> tuple[str, str, str, str]:
    cache_path = provider.stored_cache_path(profile)
    raw = None
    if use_api:
        if provider.name == "codex":
            # Token rotation writes the live auth file. Do not do that while a Codex
            # session is running: the session may write its own copy back.
            live_conflict = active and bool(find_active_sessions(provider, include_app_server=True))
            refreshed = False
            if codex_token_needs_refresh(cred) and not live_conflict:
                refreshed = refresh_codex_credential(cred)
            if refreshed and active and not live_conflict:
                write_json(provider.live_credential_path(), cred)
            if refreshed or (active and not live_conflict):
                write_json(provider.stored_credential_path(profile), cred)
                write_json(provider.stored_meta_path(profile), credential_summary(provider, cred))
        raw = fetch_usage(provider, cred)
        attempt_at = now_iso()
        if isinstance(raw, dict) and raw:
            write_json(cache_path, {"fetched_at": attempt_at, "raw": raw,
                                    "last_attempt_at": attempt_at, "refresh_status": "refreshed"})
        else:
            raw = None
            cached = read_json(cache_path, {}, strict=False)
            cached = cached if isinstance(cached, dict) else {}
            cached.update(last_attempt_at=attempt_at, refresh_status="unavailable")
            write_json(cache_path, cached)
    else:
        cache = read_json(cache_path, {}, strict=False)
        if isinstance(cache, dict):
            raw = cache.get("raw")
    if not isinstance(raw, dict):
        return "?", "?", "?", "?"
    if provider.name == "opencode":
        snapshot = usage_snapshot(provider, raw)
        return (str(snapshot.get("five_hour", "?")), str(snapshot.get("seven_day", "?")),
                format_reset_time(snapshot.get("five_hour_resets_at")), format_reset_time(snapshot.get("seven_day_resets_at")))
    if provider.name == "claude":
        five = raw.get("five_hour") or {}
        seven = raw.get("seven_day") or {}
        return (
            str(five.get("utilization", "?")),
            str(seven.get("utilization", "?")),
            format_reset_time(five.get("resets_at")),
            format_reset_time(seven.get("resets_at")),
        )
    rate = raw.get("rate_limit") or {}
    primary = rate.get("primary_window") or {}
    secondary = rate.get("secondary_window") or {}
    return (
        str(primary.get("used_percent", "?")),
        str(secondary.get("used_percent", "?")),
        format_reset_time(primary.get("reset_at")),
        format_reset_time(secondary.get("reset_at")),
    )


