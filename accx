def http_get_json(url: str, headers: dict[str, str]) -> dict[str, Any] | None:
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None


def http_post_form_json(url: str, form: dict[str, str]) -> dict[str, Any] | None:
    body = urllib.parse.urlencode(form).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None


def refresh_codex_credential(cred: dict[str, Any]) -> bool:
    refresh = credential_refresh_token(Provider("codex"), cred)
    if not refresh:
        return False
    response = http_post_form_json(
        CODEX_TOKEN_URL,
        {
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "client_id": CODEX_CLIENT_ID,
        },
    )
    if not isinstance(response, dict) or not response.get("access_token"):
        return False

    tokens = cred.setdefault("tokens", {})
    tokens["access_token"] = response["access_token"]
    if response.get("refresh_token"):
        tokens["refresh_token"] = response["refresh_token"]
    if response.get("id_token"):
        tokens["id_token"] = response["id_token"]
    cred["last_refresh"] = now_iso()
    return True


def codex_token_needs_refresh(cred: dict[str, Any]) -> bool:
    expiry = credential_access_expiry_ms(Provider("codex"), cred)
    return expiry is not None and expiry <= ms_now() + 60_000


def fetch_usage(provider: Provider, cred: dict[str, Any]) -> dict[str, Any] | None:
    access = credential_access_token(provider, cred)
    if not access:
        return None
    if provider.name == "claude":
        return http_get_json(
            "https://api.anthropic.com/api/oauth/usage",
            {"Authorization": f"Bearer {access}", "anthropic-beta": "oauth-2025-04-20"},
        )
    headers = {"Authorization": f"Bearer {access}", "User-Agent": "codex-cli"}
    account_id = codex_account_id(cred)
    if account_id:
        headers["ChatGPT-Account-Id"] = account_id
    return http_get_json("https://chatgpt.com/backend-api/wham/usage", headers)


